{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Horizontal dumbbell chart comparing five visual player perspectives in 1980–84 and 2020–24, using a visual-perspective-only denominator.",
  "width": 610,
  "height": 300,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/player_perspective_dumbbell_visual_only_1980_84_vs_2020_24.csv"
  },
  "title": {
    "text": "How Have Visual Player Perspectives Shifted from Early to Modern Gaming?",
    "subtitle": [
      "Share of main games with at least one selected visual perspective, 1980–84 vs 2020–24.",
      "Only Side view, First person, Bird view / Isometric, Third person, and Virtual Reality are included; games may contain multiple perspectives."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 11,
    "subtitleColor": "#666666",
    "offset": 14
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#C9CDD3"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": [
            "Side view",
            "First person",
            "Bird view / Isometric",
            "Third person",
            "Virtual Reality"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelLimit": 170
          }
        },
        "x": {
          "field": "pct_1980_84",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ]
          },
          "axis": {
            "title": "Share of games with selected visual perspective metadata (%)",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "grid": true,
            "tickCount": 6
          }
        },
        "x2": {
          "field": "pct_2020_24"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#6B7280",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": [
            "Side view",
            "First person",
            "Bird view / Isometric",
            "Third person",
            "Virtual Reality"
          ]
        },
        "x": {
          "field": "pct_1980_84",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "value": "1980–84",
            "title": "Period"
          },
          {
            "field": "pct_1980_84",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "count_1980_84",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "denominator_1980_84",
            "type": "quantitative",
            "title": "Games with selected visual perspective data",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "'1980–84: ' + format(datum.pct_1980_84, '.1f') + '%'",
          "as": "label_early"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -13,
        "fontSize": 10,
        "color": "#4B5563"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": [
            "Side view",
            "First person",
            "Bird view / Isometric",
            "Third person",
            "Virtual Reality"
          ]
        },
        "x": {
          "field": "pct_1980_84",
          "type": "quantitative"
        },
        "text": {
          "field": "label_early"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#0F766E",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": [
            "Side view",
            "First person",
            "Bird view / Isometric",
            "Third person",
            "Virtual Reality"
          ]
        },
        "x": {
          "field": "pct_2020_24",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "value": "2020–24",
            "title": "Period"
          },
          {
            "field": "pct_2020_24",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "count_2020_24",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "denominator_2020_24",
            "type": "quantitative",
            "title": "Games with selected visual perspective data",
            "format": ","
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "'2020–24: ' + format(datum.pct_2020_24, '.1f') + '%'",
          "as": "label_modern"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 14,
        "fontSize": 10,
        "color": "#0F766E"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": [
            "Side view",
            "First person",
            "Bird view / Isometric",
            "Third person",
            "Virtual Reality"
          ]
        },
        "x": {
          "field": "pct_2020_24",
          "type": "quantitative"
        },
        "text": {
          "field": "label_modern"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#D1D5DB",
      "gridColor": "#ECEFF1"
    }
  }
}