{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Vertical bars, sorted from most to fewest (24,694 down to 2,706), showing distinct game counts per mode in 27,416 IGDB main games released in 1980–2024 with at least one retained shared-play mode. Battle Royale is removed before selecting the subset. Single-player-only games are excluded. Modes overlap, so the bars add up to more than 27,416.",
  "title": {
    "text": "What Modes Do Multiplayer Games Offer?",
    "anchor": "start",
    "dx": -11,
    "fontSize": 19,
    "offset": 28
  },
  "width": 366,
  "height": 365,
  "autosize": {
    "type": "none"
  },
  "padding": {
    "left": 70,
    "right": 16,
    "top": 60,
    "bottom": 72
  },
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_bar_counts_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'Massively Multiplayer Online' : datum.Mode",
      "as": "Mode_display"
    }
  ],
  "encoding": {
    "x": {
      "field": "Mode_display",
      "type": "nominal",
      "sort": [
        "Multiplayer",
        "Single player",
        "Co-operative",
        "Split screen",
        "Massively Multiplayer Online"
      ],
      "title": "Game Mode",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelLineHeight": 13,
        "labelPadding": 6,
        "ticks": false,
        "domainColor": "#9AA1AD",
        "labelExpr": "split(datum.value, ' ')",
        "labelColor": "#333333",
        "titleFontSize": 12,
        "titlePadding": 8,
        "titleY": 55
      }
    },
    "y": {
      "field": "Games",
      "type": "quantitative",
      "title": "Number of Games Offering This Mode",
      "scale": {
        "domain": [
          0,
          28000
        ]
      },
      "axis": {
        "format": ",d",
        "values": [
          0,
          5000,
          10000,
          15000,
          20000,
          25000
        ],
        "grid": false,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2,
        "width": {
          "band": 0.62
        }
      },
      "encoding": {
        "color": {
          "field": "Mode_display",
          "type": "nominal",
          "scale": {
            "domain": [
              "Multiplayer",
              "Single player",
              "Co-operative",
              "Split screen",
              "Massively Multiplayer Online"
            ],
            "range": [
              "#00A6D6",
              "#C9B27D",
              "#1B9E77",
              "#8C564B",
              "#666666"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Mode_display",
            "type": "nominal",
            "title": "Game mode"
          },
          {
            "field": "Games",
            "type": "quantitative",
            "title": "Games offering this mode",
            "format": ",d"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "text": {
          "field": "Games",
          "type": "quantitative",
          "format": ",d"
        }
      }
    },
    {
      "description": "Annotation explaining why so few games are massively multiplayer, with a short leader to the bar's label.",
      "data": {
        "values": [
          {
            "Mode_display": "Massively Multiplayer Online",
            "Games": 13000,
            "y2": 8500,
            "y3": 4100,
            "note": "Massive online worlds need|servers and new content long|after launch, a cost few|studios can sustain"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "dx": 38,
            "fontSize": 11,
            "lineHeight": 14,
            "lineBreak": "|",
            "color": "#3F4756"
          },
          "encoding": {
            "text": {
              "field": "note"
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#9AA1AD",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "y2",
              "type": "quantitative"
            },
            "y2": {
              "field": "y3"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "titleFontWeight": "bold",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "text": {
      "fontSize": 11
    }
  }
}