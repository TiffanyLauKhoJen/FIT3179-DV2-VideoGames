{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Marimekko chart comparing distinct-title catalogue size and genre composition for six major video game publishers.",
  "width": 820,
  "height": 440,
  "padding": {
    "left": 10,
    "right": 20,
    "top": 10,
    "bottom": 55
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_genre_marimekko.csv",
    "format": {
      "type": "csv",
      "parse": {
        "publisher_order": "number",
        "publisher_total_titles": "number",
        "publisher_width_pct": "number",
        "genre_order": "number",
        "distinct_title_count": "number",
        "genre_share_pct": "number",
        "x0": "number",
        "x1": "number",
        "x_mid": "number",
        "y0": "number",
        "y1": "number",
        "y_mid": "number"
      }
    }
  },
  "title": {
    "text": "How Do Major Video Game Publishers Differ in Their Genre Portfolios?",
    "subtitle": [
      "Column width shows each publisher's distinct-title catalogue size; segment height shows genre share.",
      "Six leading genres are shown separately; remaining valid genres are grouped as Other."
    ],
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Genre Share Within Publisher (%)",
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "grid": true
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "title": "Genre",
          "sort": [
            "Sports",
            "Action",
            "Shooter",
            "Platform",
            "Puzzle",
            "Role-Playing",
            "Other"
          ],
          "scale": {
            "scheme": "tableau10"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "publisher",
            "type": "nominal",
            "title": "Publisher"
          },
          {
            "field": "publisher_total_titles",
            "type": "quantitative",
            "title": "Publisher Distinct Titles",
            "format": ",d"
          },
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "distinct_title_count",
            "type": "quantitative",
            "title": "Distinct Titles",
            "format": ",d"
          },
          {
            "field": "genre_share_pct",
            "type": "quantitative",
            "title": "Share of Publisher Catalogue",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.genre_order == 1"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "align": "center",
        "dy": 10,
        "fontSize": 11,
        "fontWeight": "bold",
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "text": {
          "field": "publisher_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.genre_order == 1"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "align": "center",
        "dy": 27,
        "fontSize": 10,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "text": {
          "field": "publisher_total_titles",
          "type": "quantitative",
          "format": ",d"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}