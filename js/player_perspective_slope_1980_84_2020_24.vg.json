{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Slope chart comparing selected visual player perspectives in early and modern gaming.",
  "width": 620,
  "height": 430,
  "padding": {
    "left": 175,
    "right": 175,
    "top": 10,
    "bottom": 10
  },
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/player_perspective_slope_1980_84_2020_24.csv"
  },
  "title": {
    "text": "How Have Visual Player Perspectives Shifted from Early to Modern Gaming?",
    "subtitle": [
      "Share of main games with at least one of five selected visual perspectives, 1980–84 vs 2020–24.",
      "Games may contain multiple perspectives; Auditory and Text are excluded."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666",
    "offset": 14
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": {
            "field": "period_order",
            "order": "ascending"
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": "bold",
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ]
          },
          "axis": {
            "title": "Share of games with selected visual perspective metadata (%)",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "grid": true,
            "gridColor": "#E5E7EB",
            "domain": false,
            "tickColor": "#D1D5DB"
          }
        },
        "detail": {
          "field": "perspective"
        },
        "order": {
          "field": "period_order"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increased",
              "Decreased",
              "No change"
            ],
            "range": [
              "#239C96",
              "#8C95A3",
              "#6B7280"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Period"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Period denominator",
            "format": ","
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": {
            "field": "period_order",
            "order": "ascending"
          }
        },
        "y": {
          "field": "share_pct",
          "type": "quantitative"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increased",
              "Decreased",
              "No change"
            ],
            "range": [
              "#239C96",
              "#8C95A3",
              "#6B7280"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Period"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.share_pct != datum.label_y"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "opacity": 0.45
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": {
            "field": "period_order",
            "order": "ascending"
          }
        },
        "y": {
          "field": "share_pct",
          "type": "quantitative"
        },
        "y2": {
          "field": "label_y"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increased",
              "Decreased",
              "No change"
            ],
            "range": [
              "#239C96",
              "#8C95A3",
              "#6B7280"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '1980–84'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "fontSize": 11.5
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": {
            "field": "period_order",
            "order": "ascending"
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "endpoint_label"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increased",
              "Decreased",
              "No change"
            ],
            "range": [
              "#239C96",
              "#6B7280",
              "#6B7280"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2020–24'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 11.5,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": {
            "field": "period_order",
            "order": "ascending"
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "endpoint_label"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increased",
              "Decreased",
              "No change"
            ],
            "range": [
              "#167C78",
              "#6B7280",
              "#6B7280"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}