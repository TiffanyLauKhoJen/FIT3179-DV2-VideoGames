{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Scatter plot comparing IGDB user ratings with aggregated external-review ratings for main games released from 1980 to 2024.",
  "width": 520,
  "height": 520,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/user_critic_ratings_scatter.csv",
    "format": {
      "type": "csv",
      "parse": {
        "release_year": "number",
        "rating": "number",
        "aggregated_rating": "number",
        "critic_user_gap": "number"
      }
    }
  },
  "title": {
    "text": "How Closely Do Player and Critic Ratings Align?",
    "subtitle": [
      "Main games released from 1980–2024 with both IGDB user and aggregated external-review ratings.",
      "The dashed diagonal indicates equal scores; the solid line shows the overall relationship (r ≈ 0.38)."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6
  },
  "params": [
    {
      "name": "game_hover",
      "select": {
        "type": "point",
        "on": "pointerover",
        "clear": "pointerout",
        "nearest": true
      }
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {"rating": 0, "aggregated_rating": 0},
          {"rating": 100, "aggregated_rating": 100}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#777",
        "strokeDash": [6, 5],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        },
        "y": {
          "field": "aggregated_rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#4E79A7",
        "size": 28
      },
      "encoding": {
        "x": {
          "field": "rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "axis": {
            "title": "IGDB User Rating",
            "tickCount": 6,
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },
        "y": {
          "field": "aggregated_rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "axis": {
            "title": "Aggregated External-Review Rating",
            "tickCount": 6,
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },
        "opacity": {
          "condition": {"param": "game_hover", "empty": false, "value": 1},
          "value": 0.15
        },
        "stroke": {"value": "#111"},
        "strokeWidth": {
          "condition": {"param": "game_hover", "empty": false, "value": 1.5},
          "value": 0
        },
        "tooltip": [
          {"field": "name", "type": "nominal", "title": "Game"},
          {"field": "release_year", "type": "quantitative", "title": "Release year", "format": "d"},
          {"field": "primary_genre", "type": "nominal", "title": "Primary genre"},
          {"field": "rating", "type": "quantitative", "title": "IGDB user rating", "format": ".1f"},
          {"field": "aggregated_rating", "type": "quantitative", "title": "External-review rating", "format": ".1f"},
          {"field": "critic_user_gap", "type": "quantitative", "title": "Critic − user difference", "format": "+.1f"},
          {"field": "agreement", "type": "nominal", "title": "Comparison"}
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "aggregated_rating",
          "on": "rating",
          "method": "linear"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#E15759",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        },
        "y": {
          "field": "aggregated_rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        }
      }
    },
    {
      "data": {
        "values": [
          {"rating": 78, "aggregated_rating": 82, "label": "Equal ratings"}
        ]
      },
      "mark": {
        "type": "text",
        "angle": 315,
        "align": "left",
        "baseline": "bottom",
        "color": "#666",
        "fontSize": 11,
        "dx": 4,
        "dy": -2
      },
      "encoding": {
        "x": {
          "field": "rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        },
        "y": {
          "field": "aggregated_rating",
          "type": "quantitative",
          "scale": {"domain": [0, 100]}
        },
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12
    }
  }
}
