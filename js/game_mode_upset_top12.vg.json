{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "UpSet plot of the top 12 exact game-mode combinations among main games released from 1980 to 2024 that offer at least one non-single-player mode.",
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_upset_top12.csv",
    "format": {
      "type": "csv",
      "parse": {
        "combination_order": "number",
        "intersection_count": "number",
        "intersection_share_pct": "number",
        "mode_order": "number",
        "included": "number",
        "mode_total": "number",
        "eligible_games": "number",
        "top12_coverage_pct": "number"
      }
    }
  },
  "title": {
    "text": "Which Combinations of Game Modes Are Most Common?",
    "subtitle": [
      "Top 12 exact combinations among main games from 1980–2024 offering at least one non-single-player mode.",
      "Each game is counted once; the displayed combinations cover 95.4% of 27,482 eligible games."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6
  },
  "spacing": 4,
  "vconcat": [
    {
      "width": 760,
      "height": 245,
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "intersection_count",
              "as": "intersection_count"
            },
            {
              "op": "max",
              "field": "intersection_share_pct",
              "as": "intersection_share_pct"
            },
            {
              "op": "max",
              "field": "eligible_games",
              "as": "eligible_games"
            }
          ],
          "groupby": [
            "combination_id",
            "combination_label",
            "combination_order"
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#4E79A7",
            "cornerRadiusTopLeft": 2,
            "cornerRadiusTopRight": 2
          },
          "encoding": {
            "x": {
              "field": "combination_id",
              "type": "ordinal",
              "sort": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "C11",
                "C12"
              ],
              "scale": {
                "paddingInner": 0.36,
                "paddingOuter": 0.18
              },
              "axis": null
            },
            "y": {
              "field": "intersection_count",
              "type": "quantitative",
              "axis": {
                "title": "Games in exact combination",
                "format": ",d",
                "gridColor": "#E8E8E8",
                "tickCount": 5
              }
            },
            "tooltip": [
              {
                "field": "combination_id",
                "type": "nominal",
                "title": "Combination"
              },
              {
                "field": "combination_label",
                "type": "nominal",
                "title": "Exact modes"
              },
              {
                "field": "intersection_count",
                "type": "quantitative",
                "title": "Games",
                "format": ",d"
              },
              {
                "field": "intersection_share_pct",
                "type": "quantitative",
                "title": "Eligible games (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -7,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#333"
          },
          "encoding": {
            "x": {
              "field": "combination_id",
              "type": "ordinal",
              "sort": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "C11",
                "C12"
              ],
              "scale": {
                "paddingInner": 0.36,
                "paddingOuter": 0.18
              },
              "axis": null
            },
            "y": {
              "field": "intersection_count",
              "type": "quantitative"
            },
            "text": {
              "field": "intersection_count",
              "type": "quantitative",
              "format": ",d"
            }
          }
        }
      ]
    },
    {
      "width": 760,
      "height": 215,
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.mode_order === 1"
            }
          ],
          "mark": {
            "type": "rule",
            "stroke": "#333",
            "strokeWidth": 2.3
          },
          "encoding": {
            "x": {
              "field": "combination_id",
              "type": "ordinal",
              "sort": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "C11",
                "C12"
              ],
              "scale": {
                "paddingInner": 0.36,
                "paddingOuter": 0.18
              },
              "axis": null
            },
            "y": {
              "field": "connector_start",
              "type": "ordinal",
              "sort": [
                "Single player",
                "Multiplayer",
                "Co-operative",
                "Split screen",
                "Massively Multiplayer Online (MMO)",
                "Battle Royale"
              ]
            },
            "y2": {
              "field": "connector_end"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "strokeWidth": 0
          },
          "encoding": {
            "x": {
              "field": "combination_id",
              "type": "ordinal",
              "sort": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "C11",
                "C12"
              ],
              "scale": {
                "paddingInner": 0.36,
                "paddingOuter": 0.18
              },
              "axis": {
                "title": "Exact mode combination",
                "labelAngle": 0,
                "labelPadding": 8,
                "ticks": false,
                "domain": false
              }
            },
            "y": {
              "field": "mode",
              "type": "ordinal",
              "sort": [
                "Single player",
                "Multiplayer",
                "Co-operative",
                "Split screen",
                "Massively Multiplayer Online (MMO)",
                "Battle Royale"
              ],
              "axis": {
                "title": null,
                "labelLimit": 245,
                "labelPadding": 8,
                "ticks": false,
                "domain": false
              }
            },
            "size": {
              "condition": {
                "test": "datum.included === 1",
                "value": 150
              },
              "value": 65
            },
            "color": {
              "condition": {
                "test": "datum.included === 1",
                "value": "#333333"
              },
              "value": "#D9D9D9"
            },
            "tooltip": [
              {
                "field": "combination_id",
                "type": "nominal",
                "title": "Combination"
              },
              {
                "field": "combination_label",
                "type": "nominal",
                "title": "Exact modes"
              },
              {
                "field": "intersection_count",
                "type": "quantitative",
                "title": "Games",
                "format": ",d"
              },
              {
                "field": "mode",
                "type": "nominal",
                "title": "Mode row"
              },
              {
                "field": "included",
                "type": "quantitative",
                "title": "Included (1=yes)"
              },
              {
                "field": "mode_total",
                "type": "quantitative",
                "title": "Mode total in scope",
                "format": ",d"
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12
    },
    "concat": {
      "spacing": 4
    }
  }
}
