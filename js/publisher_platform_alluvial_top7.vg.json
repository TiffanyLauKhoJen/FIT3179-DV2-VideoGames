{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Alluvial diagram showing how the top 7 publishers differ in platform ecosystem strategy.",
  "width": 860,
  "height": 520,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_platform_alluvial_top7.csv",
    "format": {
      "type": "csv",
      "parse": {
        "publisher_rank": "number",
        "publisher_total_titles": "number",
        "publisher_total_associations": "number",
        "ecosystem_total_associations": "number",
        "flow_count": "number",
        "publisher_share_pct": "number",
        "ecosystem_share_pct": "number",
        "y0": "number",
        "y1": "number",
        "node_y0": "number",
        "node_y1": "number",
        "source_x0": "number",
        "source_x1": "number",
        "target_x0": "number",
        "target_x1": "number",
        "source_node_y0": "number",
        "source_node_y1": "number",
        "target_node_y0": "number",
        "target_node_y1": "number",
        "source_mid_y": "number",
        "target_mid_y": "number",
        "flow_mid_y0": "number",
        "flow_mid_y1": "number",
        "flow_mid_x0": "number",
        "flow_mid_x1": "number"
      }
    }
  },
  "title": {
    "text": "How Do Major Publishers Differ in Their Platform Strategies?",
    "subtitle": [
      "Top 7 exact publishers by distinct titles in the Video Games Sales collection.",
      "Flows show distinct title\u2013platform ecosystem associations; a title is counted once per ecosystem."
    ],
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.6
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              0
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "detail": {
          "field": "publisher"
        },
        "color": {
          "field": "publisher",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sega",
              "Microsoft",
              "Nintendo",
              "Konami",
              "Sony Computer Entertainment",
              "Ubisoft",
              "Electronic Arts"
            ],
            "range": [
              "#4C78A8",
              "#F58518",
              "#E45756",
              "#72B7B2",
              "#54A24B",
              "#EECA3B",
              "#B279A2"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "publisher",
            "type": "nominal",
            "title": "Publisher"
          },
          {
            "field": "ecosystem",
            "type": "nominal",
            "title": "Platform ecosystem"
          },
          {
            "field": "flow_count",
            "type": "quantitative",
            "title": "Distinct title\u2013ecosystem links",
            "format": ",d"
          },
          {
            "field": "publisher_share_pct",
            "type": "quantitative",
            "title": "Share within publisher (%)",
            "format": ".1f"
          },
          {
            "field": "publisher_total_titles",
            "type": "quantitative",
            "title": "Publisher distinct titles",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "source_node_y0",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "source_node_y1",
              "as": "y1"
            },
            {
              "op": "min",
              "field": "source_mid_y",
              "as": "ymid"
            },
            {
              "op": "max",
              "field": "publisher_total_associations",
              "as": "total_assoc"
            },
            {
              "op": "max",
              "field": "publisher_total_titles",
              "as": "total_titles"
            }
          ],
          "groupby": [
            "publisher",
            "publisher_rank"
          ]
        },
        {
          "calculate": "datum.publisher + '  (' + format(datum.total_assoc, ',d') + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#d9d9d9",
        "stroke": "white"
      },
      "encoding": {
        "x": {
          "datum": 0.08,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "x2": {
          "datum": 0.2
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              0
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "target_node_y0",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "target_node_y1",
              "as": "y1"
            },
            {
              "op": "min",
              "field": "target_mid_y",
              "as": "ymid"
            },
            {
              "op": "max",
              "field": "ecosystem_total_associations",
              "as": "total_assoc"
            }
          ],
          "groupby": [
            "ecosystem"
          ]
        },
        {
          "calculate": "datum.ecosystem + '  (' + format(datum.total_assoc, ',d') + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": "#d9d9d9",
        "stroke": "white"
      },
      "encoding": {
        "x": {
          "datum": 0.8,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "x2": {
          "datum": 0.92
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              0
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "source_node_y0",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "source_node_y1",
              "as": "y1"
            },
            {
              "op": "min",
              "field": "source_mid_y",
              "as": "ymid"
            },
            {
              "op": "max",
              "field": "publisher_total_associations",
              "as": "total_assoc"
            }
          ],
          "groupby": [
            "publisher",
            "publisher_rank"
          ]
        },
        {
          "calculate": "datum.publisher + '  (' + format(datum.total_assoc, ',d') + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "datum": 0.08,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ymid",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              0
            ]
          },
          "axis": null
        },
        "text": {
          "field": "publisher"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "target_node_y0",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "target_node_y1",
              "as": "y1"
            },
            {
              "op": "min",
              "field": "target_mid_y",
              "as": "ymid"
            },
            {
              "op": "max",
              "field": "ecosystem_total_associations",
              "as": "total_assoc"
            }
          ],
          "groupby": [
            "ecosystem"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "datum": 0.92,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ymid",
          "type": "quantitative",
          "scale": {
            "domain": [
              100,
              0
            ]
          },
          "axis": null
        },
        "text": {
          "field": "ecosystem"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}