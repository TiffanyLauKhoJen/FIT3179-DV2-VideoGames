{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Are Game Organisations Located?"
  },
  "width": 1020,
  "height": 500,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamedev_dots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 10,
        "opacity": 0.7,
        "stroke": "lightgrey",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "datum": "1 dot = 1 game organisation",
          "type": "nominal",
          "scale": {
            "range": [
              "#B2182B"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "symbolSize": 60,
            "symbolOpacity": 1,
            "symbolStrokeColor": "lightgrey",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 12,
            "labelLimit": 250
          }
        },
        "tooltip": [
          {
            "field": "Organization",
            "type": "nominal",
            "title": "Organization"
          },
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Category",
            "type": "nominal",
            "title": "Category"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12
    }
  }
}
