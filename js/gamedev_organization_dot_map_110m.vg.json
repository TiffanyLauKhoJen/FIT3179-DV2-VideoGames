{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are listed game organizations concentrated?",
    "subtitle": "1 dot = 1 GameDevMap listing (10,417)"
  },
  "width": 760,
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamedev_dots.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 12,
        "opacity": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "Type",
          "type": "nominal",
          "title": "Type of organization",
          "scale": {
            "domain": [
              "Developer",
              "Publisher",
              "Mobile",
              "XR (VR/AR)",
              "Other"
            ],
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#CC79A7",
              "#7A7F87"
            ]
          },
          "legend": {
            "orient": "right",
            "symbolSize": 110,
            "symbolOpacity": 1,
            "labelFontSize": 12,
            "titleFontSize": 13,
            "labelLimit": 180
          }
        },
        "tooltip": [
          {
            "field": "Organization",
            "type": "nominal",
            "title": "Organization"
          },
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Category",
            "type": "nominal",
            "title": "Category"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12
    }
  }
}
