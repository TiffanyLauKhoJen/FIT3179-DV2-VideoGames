{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing eight selected genres across recorded IGDB main games released in 2010 and 2024.",
  "title": {
    "text": [
      "Differences in Video Game Genre Shares (2010 - 2024)"
    ],
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#526274",
    "offset": 16
  },
  "width": 460,
  "height": {"step": 50},
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_dumbbell_8_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games_2010": "number",
        "Main_games_2010": "number",
        "Pct_2010": "number",
        "Games_2024": "number",
        "Main_games_2024": "number",
        "Pct_2024": "number",
        "Change_pp": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "Genre",
      "type": "nominal",
      "sort": [
        "Adventure",
        "Action",
        "Simulator",
        "Strategy",
        "Role-Playing",
        "Shooter",
        "Sports",
        "Puzzle"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 12,
        "labelLimit": 155,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#A5B2C2",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Pct_2010",
          "type": "quantitative",
          "scale": {"domain": [0, 50], "nice": false},
          "title": "Share of recorded main games (%)",
          "axis": {
            "values": [0, 10, 20, 30, 40, 50],
            "grid": true,
            "gridColor": "#E6EBF0",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "x2": {"field": "Pct_2024"},
        "tooltip": [
          {
            "field": "Genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "Pct_2010",
            "type": "quantitative",
            "title": "2010 share (%)",
            "format": ".1f"
          },
          {
            "field": "Games_2010",
            "type": "quantitative",
            "title": "2010 games in genre",
            "format": ",d"
          },
          {
            "field": "Main_games_2010",
            "type": "quantitative",
            "title": "2010 total main games",
            "format": ",d"
          },
          {
            "field": "Pct_2024",
            "type": "quantitative",
            "title": "2024 share (%)",
            "format": ".1f"
          },
          {
            "field": "Games_2024",
            "type": "quantitative",
            "title": "2024 games in genre",
            "format": ",d"
          },
          {
            "field": "Main_games_2024",
            "type": "quantitative",
            "title": "2024 total main games",
            "format": ",d"
          },
          {
            "field": "Change_pp",
            "type": "quantitative",
            "title": "Change (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": ["Pct_2010", "Pct_2024"],
          "as": ["Year_field", "Share_pct"]
        },
        {
          "calculate": "datum.Year_field === 'Pct_2010' ? '2010' : '2024'",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 180,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Share_pct",
          "type": "quantitative",
          "scale": {"domain": [0, 50], "nice": false}
        },
        "color": {
          "field": "Year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": ["2010", "2024"],
            "range": ["#7B8794", "#882255"]
          },
          "legend": {
            "orient": "right",
            "symbolSize": 150,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "Genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Share_pct",
            "type": "quantitative",
            "title": "Games in genre (%)",
            "format": ".1f"
          },
          {
            "field": "Change_pp",
            "type": "quantitative",
            "title": "Change (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "Annotations and leader lines, placed in pixels in clear space: one above the plot for Adventure, one between the Role-Playing and Shooter rows for Simulator.",
      "data": {"values": [{}]},
      "mark": {"type": "rule", "color": "#9AA1AD", "strokeWidth": 1},
      "encoding": {"x": {"value": 300}, "y": {"value": -9}, "x2": {"value": 300}, "y2": {"value": 16}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "rule", "color": "#9AA1AD", "strokeWidth": 1},
      "encoding": {"x": {"value": 201}, "y": {"value": 133}, "x2": {"value": 208}, "y2": {"value": 231}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "Players helped fund new adventure games through crowdfunding.", "align": "left", "baseline": "top", "fontSize": 11, "color": "#3F4756"},
      "encoding": {"x": {"value": 150}, "y": {"value": -40}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "Double Fine Adventure raised", "align": "left", "baseline": "top", "fontSize": 11, "color": "#3F4756"},
      "encoding": {"x": {"value": 150}, "y": {"value": -26}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "$3.3 million", "align": "left", "baseline": "top", "fontSize": 11, "fontWeight": "bold", "color": "#1F2937"},
      "encoding": {"x": {"value": 298.6}, "y": {"value": -26}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "from backers.", "align": "left", "baseline": "top", "fontSize": 11, "color": "#3F4756"},
      "encoding": {"x": {"value": 361.6}, "y": {"value": -26}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "Farming and life simulation games gained attention during the pandemic,", "align": "left", "baseline": "top", "fontSize": 11, "color": "#3F4756"},
      "encoding": {"x": {"value": 174}, "y": {"value": 236}}
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "text", "text": "offering relaxation and an escape from stress.", "align": "left", "baseline": "top", "fontSize": 11, "color": "#3F4756"},
      "encoding": {"x": {"value": 174}, "y": {"value": 250}}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}