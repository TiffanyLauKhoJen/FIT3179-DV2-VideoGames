{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing eight selected genres across recorded IGDB main games released in 2010 and 2024.",
  "title": {
    "text": [
      "Differences in Video Game Genre Shares (2010 - 2024)"
    ],
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 11,
    "subtitleColor": "#526274",
    "offset": 16
  },
  "width": 460,
  "height": {"step": 40},
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_dumbbell_8_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games_2010": "number",
        "Main_games_2010": "number",
        "Pct_2010": "number",
        "Games_2024": "number",
        "Main_games_2024": "number",
        "Pct_2024": "number",
        "Change_pp": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "Genre",
      "type": "nominal",
      "sort": [
        "Adventure",
        "Action",
        "Simulator",
        "Strategy",
        "Role-Playing",
        "Shooter",
        "Sports",
        "Puzzle"
      ],
      "scale": {
        "domain": ["Adventure", "Action", "Simulator", "Strategy", "Role-Playing", "Shooter", "Sports", "Puzzle"]
      },
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 12,
        "labelLimit": 155,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "transform": [
        {"calculate": "format(datum.Pct_2010, '.1f') + '%'", "as": "Share_2010_label"},
        {"calculate": "format(datum.Pct_2024, '.1f') + '%'", "as": "Share_2024_label"},
        {"calculate": "format(datum.Change_pp, '+.1f') + ' percentage points'", "as": "Change_label"}
      ],
      "mark": {
        "type": "rule",
        "stroke": "#A5B2C2",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Pct_2010",
          "type": "quantitative",
          "scale": {"domain": [0, 50], "nice": false},
          "title": "Share of recorded main games (%)",
          "axis": {
            "values": [0, 10, 20, 30, 40, 50],
            "grid": true,
            "gridColor": "#E6EBF0",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "x2": {"field": "Pct_2024"},
        "tooltip": [
          {"field": "Genre", "type": "nominal", "title": "Genre"},
          {"field": "Share_2010_label", "type": "nominal", "title": "2010 share"},
          {"field": "Share_2024_label", "type": "nominal", "title": "2024 share"},
          {"field": "Change_label", "type": "nominal", "title": "Change"}
        ]
      }
    },
    {
      "description": "Leader lines from each 2024 circle to its note (drawn before the circles so the circles cover the line ends).",
      "data": {
        "values": [
          {"x": 38.42, "x2": 46, "Genre": "Adventure", "Genre2": "Simulator"},
          {"x": 21.47, "x2": 26, "Genre": "Simulator", "Genre2": "Role-Playing"}
        ]
      },
      "mark": {"type": "rule", "color": "#9AA1AD", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "Genre2"}
      }
    },
    {
      "transform": [
        {
          "fold": ["Pct_2010", "Pct_2024"],
          "as": ["Year_field", "Share_pct"]
        },
        {
          "calculate": "datum.Year_field === 'Pct_2010' ? '2010' : '2024'",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 180,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Share_pct",
          "type": "quantitative",
          "scale": {"domain": [0, 50], "nice": false}
        },
        "color": {
          "field": "Year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": ["2010", "2024"],
            "range": ["#EE6677", "#882255"]
          },
          "legend": {
            "orient": "right",
            "symbolSize": 150,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "Genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Share_pct",
            "type": "quantitative",
            "title": "Games in genre (%)",
            "format": ".1f"
          },
          {
            "field": "Change_pp",
            "type": "quantitative",
            "title": "Change (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "Annotation text, positioned by share (x) and genre row (y) like the release trend notes; | starts a new line.",
      "data": {
        "values": [
          {
            "x": 30,
            "Genre": "Simulator",
            "note": "Digital downloads and crowdfunding|helped smaller developers create and|release new adventure games."
          },
          {
            "x": 24,
            "Genre": "Role-Playing",
            "note": "Supermarket Simulator’s success encouraged|similar shop-management games, including|TCG Card Shop Simulator."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dy": 2,
        "fontSize": 11,
        "lineHeight": 14,
        "lineBreak": "|",
        "color": "#3F4756"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "note"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}