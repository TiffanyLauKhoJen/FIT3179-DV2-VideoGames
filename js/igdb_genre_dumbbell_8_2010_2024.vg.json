{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing eight selected genres across recorded IGDB main games released in 2010 and 2024.",
  "title": {
    "text": [
      "How Did Video Game Genre Shares Change (2010–2024)?"
    ],
    "anchor": "start",
    "fontSize": 19,
    "subtitleFontSize": 11,
    "subtitleColor": "#526274",
    "offset": 16
  },
  "width": 467,
  "height": {
    "step": 40
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_dumbbell_8_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games_2010": "number",
        "Main_games_2010": "number",
        "Pct_2010": "number",
        "Games_2024": "number",
        "Main_games_2024": "number",
        "Pct_2024": "number",
        "Change_pp": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "Genre",
      "type": "nominal",
      "sort": [
        "Adventure",
        "Action",
        "Simulator",
        "Strategy",
        "Role-Playing",
        "Shooter",
        "Sports",
        "Puzzle"
      ],
      "scale": {
        "domain": [
          "Adventure",
          "Action",
          "Simulator",
          "Strategy",
          "Role-Playing",
          "Shooter",
          "Sports",
          "Puzzle"
        ]
      },
      "title": "Genre",
      "axis": {
        "labelFontSize": 11,
        "labelPadding": 12,
        "labelLimit": 155,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "format(datum.Pct_2010, '.1f') + '%'",
          "as": "Share_2010_label"
        },
        {
          "calculate": "format(datum.Pct_2024, '.1f') + '%'",
          "as": "Share_2024_label"
        },
        {
          "calculate": "format(datum.Change_pp, '+.1f') + '%'",
          "as": "Change_label"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#A5B2C2",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Pct_2010",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ],
            "nice": false
          },
          "title": "Share of Recorded Main Games (%)",
          "axis": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ],
            "grid": true,
            "gridColor": "#E6EBF0",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "x2": {
          "field": "Pct_2024"
        },
        "tooltip": [
          {
            "field": "Genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "Share_2010_label",
            "type": "nominal",
            "title": "2010 share"
          },
          {
            "field": "Share_2024_label",
            "type": "nominal",
            "title": "2024 share"
          },
          {
            "field": "Change_label",
            "type": "nominal",
            "title": "Change in share"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "Pct_2010",
            "Pct_2024"
          ],
          "as": [
            "Year_field",
            "Share_pct"
          ]
        },
        {
          "calculate": "datum.Year_field === 'Pct_2010' ? '2010' : '2024'",
          "as": "Year"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 180,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ],
            "nice": false
          }
        },
        "color": {
          "field": "Year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": [
              "2010",
              "2024"
            ],
            "range": [
              "#EE6677",
              "#0033CC"
            ]
          },
          "legend": {
            "orient": "right",
            "symbolSize": 150,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Share_pct",
            "type": "quantitative",
            "title": "Games in genre (%)",
            "format": ".1f"
          },
          {
            "field": "Change_pp",
            "type": "quantitative",
            "title": "Change in share (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "description": "Annotations placed beside the row they explain; | starts a new line.",
      "layer": [
        {
          "data": {
            "values": [
              {
                "x": 19.3,
                "Genre": "Adventure",
                "note": "Double Fine's 2012 Kickstarter|revived interest in adventures"
              }
            ]
          },
          "mark": {
            "type": "text",
            "baseline": "middle",
            "fontSize": 11,
            "lineHeight": 14,
            "lineBreak": "|",
            "color": "#3F4756",
            "align": "right"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "text": {
              "field": "note"
            }
          }
        },
        {
          "description": "Simulator note: game title in italics, with dx offsets from the measured title width.",
          "layer": [
            {
              "data": {
                "values": [
                  {
                    "x": 23.5,
                    "Genre": "Simulator",
                    "note": "Supermarket Simulator"
                  }
                ]
              },
              "mark": {
                "type": "text",
                "baseline": "middle",
                "fontSize": 11,
                "color": "#3F4756",
                "align": "left",
                "dx": 0,
                "dy": -7,
                "fontStyle": "italic"
              },
              "encoding": {
                "x": {
                  "field": "x",
                  "type": "quantitative"
                },
                "text": {
                  "field": "note"
                }
              }
            },
            {
              "data": {
                "values": [
                  {
                    "x": 23.5,
                    "Genre": "Simulator",
                    "note": "'s 2024 hit"
                  }
                ]
              },
              "mark": {
                "type": "text",
                "baseline": "middle",
                "fontSize": 11,
                "color": "#3F4756",
                "align": "left",
                "dx": 112.49,
                "dy": -7
              },
              "encoding": {
                "x": {
                  "field": "x",
                  "type": "quantitative"
                },
                "text": {
                  "field": "note"
                }
              }
            },
            {
              "data": {
                "values": [
                  {
                    "x": 23.5,
                    "Genre": "Simulator",
                    "note": "sparked many shop-management games"
                  }
                ]
              },
              "mark": {
                "type": "text",
                "baseline": "middle",
                "fontSize": 11,
                "color": "#3F4756",
                "align": "left",
                "dx": 0,
                "dy": 7
              },
              "encoding": {
                "x": {
                  "field": "x",
                  "type": "quantitative"
                },
                "text": {
                  "field": "note"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "text": {
      "fontSize": 11
    }
  }
}