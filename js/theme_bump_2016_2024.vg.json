            },
            "color": {
              "value": "#3F4756"
            },
            "tooltip": null
          }
        }
      ]
    },
    {
      "description": "Callout for Erotic's 2018 climb, in the gap between ranks 4 and 5 (game title in italics on its own line).",
      "data": {
