              "as": "note"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "dx": 127.44999999999999,
            "dy": -7
          },
          "encoding": {
            "y": {
