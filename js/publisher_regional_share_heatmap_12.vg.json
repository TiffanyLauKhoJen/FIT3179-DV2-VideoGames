{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Regional sales shares for 12 selected publishers using complete regional-sales records. Each publisher's four regional shares total 100% before rounding. Selected labels highlight regional concentrations and NIS America's nearly equal North American and Japanese shares.",
  "title": {
    "text": "Where Do Publishers Earn Their Recorded Sales?",
    "anchor": "start",
    "fontSize": 19,
    "offset": 14
  },
  "width": 472,
  "height": {
    "step": 27
  },
  "background": "white",
  "padding": 12,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_regional_share_heatmap_12.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Recorded_sales_millions": "number",
        "Share_pct": "number",
        "Complete_records": "number",
        "Total_regional_sales_millions": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Region === 'PAL / Europe' ? 'Europe' : datum.Region",
      "as": "Region"
    },
    {
      "calculate": "datum.Publisher === 'EA Sports' ? 'Electronic Arts Sports' : datum.Publisher",
      "as": "Publisher"
    },
    {
      "calculate": "format(datum.Share_pct, '.1f') + '%'",
      "as": "Share_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "Region",
      "type": "nominal",
      "sort": [
        "North America",
        "Europe",
        "Japan",
        "Other"
      ],
      "title": "Region",
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelPadding": 10,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12
      },
      "scale": {
        "paddingInner": 0.035,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "Publisher",
      "type": "nominal",
      "sort": [
        "Activision",
        "Nintendo",
        "Ubisoft",
        "Electronic Arts",
        "Sega",
        "Capcom",
        "NIS America",
        "Codemasters",
        "Electronic Arts Sports",
        "Konami",
        "KOEI",
        "Tecmo Koei"
      ],
      "title": "Publisher",
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 400,
        "labelPadding": 10,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12
      },
      "scale": {
        "paddingInner": 0.055,
        "paddingOuter": 0
      }
    },
    "tooltip": [
      {
        "field": "Publisher",
        "type": "nominal",
        "title": "Publisher"
      },
      {
        "field": "Region",
        "type": "nominal",
        "title": "Region"
      },
      {
        "field": "Share_pct",
        "type": "quantitative",
        "title": "Share of publisher’s included sales (%)",
        "format": ".1f"
      },
      {
        "field": "Recorded_sales_millions",
        "type": "quantitative",
        "title": "Recorded regional sales (million copies)",
        "format": ",.2f"
      },
      {
        "field": "Complete_records",
        "type": "quantitative",
        "title": "Included title–platform releases",
        "format": ",d"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 1
      },
      "encoding": {
        "color": {
          "field": "Share_pct",
          "type": "quantitative",
          "title": "Share of publisher’s included sales (%)",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              70
            ],
            "range": [
              "#F3EDF7",
              "#D6C5E2",
              "#AD88C6",
              "#78459D",
              "#42145F"
            ],
            "nice": false,
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300,
            "gradientThickness": 12,
            "values": [
              0,
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ],
            "format": ".0f",
            "labelExpr": "datum.value + '%'",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "titleLimit": 400,
            "offset": 18
          }
        }
      }
    },
    {
      "description": "Dark outline on the labelled cells, so the highlighted values do not rely on colour alone.",
      "transform": [
        {
          "filter": "datum.Share_pct >= 50 || (datum.Publisher === 'NIS America' && (datum.Region === 'North America' || datum.Region === 'Japan'))"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#1F2937",
        "strokeWidth": 1.5,
        "cornerRadius": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Share_pct >= 50 || (datum.Publisher === 'NIS America' && (datum.Region === 'North America' || datum.Region === 'Japan'))"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.Share_pct >= 45",
            "value": "#FFFFFF"
          },
          "value": "#000000"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "text": {
      "fontSize": 11
    }
  }
}