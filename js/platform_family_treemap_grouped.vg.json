{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Hierarchical treemap of IGDB main games (1980-2024) by platform ecosystem, with related platforms merged into readable groups",
  "width": 620,
  "height": 400,
  "padding": 5,
  "autosize": "pad",
  "background": "white",
  "title": {
    "text": "Which Platforms Have the Most Games?",
    "subtitle": "Main games released 1980–2024, grouped by platform ecosystem. Hover a box for the platforms it includes.",
    "anchor": "start",
    "frame": "group",
    "fontSize": 17,
    "subtitleFontSize": 11.5,
    "subtitleColor": "#555",
    "offset": 12
  },
  "data": [
    {
      "name": "platforms",
      "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/platform_family_treemap_grouped.csv",
      "format": {
        "type": "csv",
        "parse": {
          "game_count": "number"
        }
      },
      "transform": [
        {
          "type": "joinaggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "game_count"
          ],
          "as": [
            "selected_total"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "family"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "game_count"
          ],
          "as": [
            "family_total"
          ]
        },
        {
          "type": "formula",
          "as": "share_selected_pct",
          "expr": "datum.game_count / datum.selected_total * 100"
        },
        {
          "type": "formula",
          "as": "share_family_pct",
          "expr": "datum.game_count / datum.family_total * 100"
        }
      ]
    },
    {
      "name": "tree",
      "source": "platforms",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "family"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "game_count",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.618,
          "paddingOuter": 3,
          "paddingInner": 0,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "families",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        },
        {
          "type": "formula",
          "as": "rect_width",
          "expr": "datum.x1 - datum.x0"
        },
        {
          "type": "formula",
          "as": "rect_height",
          "expr": "datum.y1 - datum.y0"
        },
        {
          "type": "formula",
          "as": "label_info",
          "expr": "datum.rect_height >= 34 && length(datum.platform_group) * 6.6 <= datum.rect_width - 8 ? ['big', datum.platform_group] : datum.rect_height >= 34 && length(datum.short_label) * 6.6 <= datum.rect_width - 8 ? ['big', datum.short_label] : datum.rect_height >= 15 && length(datum.platform_group) * 5.0 <= datum.rect_width - 4 ? ['small', datum.platform_group] : datum.rect_height >= 15 && length(datum.short_label) * 5.0 <= datum.rect_width - 4 ? ['small', datum.short_label] : ['none', '']"
        },
        {
          "type": "formula",
          "as": "label_size",
          "expr": "datum.label_info[0]"
        },
        {
          "type": "formula",
          "as": "label_text",
          "expr": "datum.label_info[1]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Computer",
        "Mobile",
        "Nintendo",
        "PlayStation",
        "Xbox",
        "Virtual Reality",
        "Sega"
      ],
      "range": [
        "#4269D0",
        "#F28E2B",
        "#76B7B2",
        "#59A14F",
        "#F2CF5B",
        "#BF8CF2",
        "#D5A06F"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Platform ecosystem",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 4,
      "symbolType": "square",
      "symbolSize": 120,
      "offset": 14,
      "padding": 6,
      "encode": {
        "symbols": {
          "update": {
            "opacity": {
              "value": 0.82
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "description": "One rectangle per platform group, coloured by ecosystem",
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "family"
          },
          "opacity": {
            "value": 0.82
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "tooltip": {
            "signal": "{'Platform ecosystem': datum.family, 'Platform group': datum.platform_group, 'Games': format(datum.game_count, ',d'), 'Share within ecosystem (%)': format(datum.share_family_pct, '.1f'), 'Share of all groups shown (%)': format(datum.share_selected_pct, '.1f'), 'Platforms included': datum.platforms_included}"
          }
        },
        "hover": {
          "opacity": {
            "value": 1
          }
        }
      }
    },
    {
      "description": "Dark outline around each ecosystem",
      "type": "rect",
      "from": {
        "data": "families"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "fillOpacity": {
            "value": 0
          },
          "stroke": {
            "value": "#30343B"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          }
        }
      }
    },
    {
      "description": "Group name: bold in large boxes, smaller in medium boxes, hidden in tiny boxes",
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fill": {
            "value": "#111111"
          }
        },
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 - (datum.label_size === 'big' && datum.rect_height >= 48 ? 7 : 0)"
          },
          "fontSize": {
            "signal": "datum.label_size === 'big' ? 11.5 : 9.5"
          },
          "fontWeight": {
            "signal": "datum.label_size === 'big' ? 'bold' : 'normal'"
          },
          "text": {
            "field": "label_text"
          },
          "limit": {
            "signal": "datum.rect_width - 4"
          }
        }
      }
    },
    {
      "description": "Game count under the name in large boxes",
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 10.5
          },
          "fill": {
            "value": "#222222"
          }
        },
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 + 8"
          },
          "text": {
            "signal": "datum.label_size === 'big' && datum.rect_height >= 48 && length(format(datum.game_count, ',d') + ' games') * 5.8 <= datum.rect_width - 8 ? format(datum.game_count, ',d') + ' games' : ''"
          },
          "limit": {
            "signal": "datum.rect_width - 4"
          }
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}