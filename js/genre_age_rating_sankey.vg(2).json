{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "description": "Sankey-style diagram linking six major video game genres to standard ESRB age ratings.",

  "width": 720,
  "height": 480,

  "padding": {
    "left": 150,
    "right": 125,
    "top": 10,
    "bottom": 10
  },

  "background": "white",

  "title": {
    "text": "How Do Major Video Game Genres Connect to ESRB Age Ratings?",
    "subtitle": [
      "Distinct title–genre–rating associations in Video_Games.csv for six genres used in the sales chart.",
      "Repeated platform records are counted once; missing and non-standard ESRB ratings are excluded."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666",
    "offset": 14
  },

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/genre_age_rating_sankey_clean.csv",
    "format": {
      "type": "csv",
      "parse": {
        "game_count": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "indexof(['Sports','Action','Shooter','Racing','Role-Playing','Platform'], datum.genre)",
      "as": "genre_order"
    },
    {
      "calculate": "indexof(['E','E10+','T','M'], datum.rating)",
      "as": "rating_order"
    }
  ],

  "layer": [

    {
      "transform": [

        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "all_associations"
            }
          ]
        },

        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "genre_total"
            }
          ],
          "groupby": [
            "genre"
          ]
        },

        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "rating_total"
            }
          ],
          "groupby": [
            "rating"
          ]
        },

        {
          "calculate": "datum.game_count / datum.genre_total",
          "as": "genre_share"
        },

        {
          "calculate": "datum.game_count / datum.rating_total",
          "as": "rating_share"
        },

        {
          "calculate": "datum.game_count / datum.all_associations",
          "as": "association_share"
        },

        {
          "calculate": "datum.genre + ' → ' + datum.rating",
          "as": "link_id"
        },

        {
          "calculate": "0",
          "as": "source_x"
        },

        {
          "calculate": "1",
          "as": "target_x"
        },

        {
          "fold": [
            "source_x",
            "target_x"
          ],
          "as": [
            "side",
            "x"
          ]
        },

        {
          "calculate": "datum.side === 'source_x' ? datum.genre_order * 10 + datum.rating_order : datum.rating_order * 10 + datum.genre_order",
          "as": "stack_order"
        },

        {
          "stack": "game_count",
          "groupby": [
            "x"
          ],
          "sort": [
            {
              "field": "stack_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        },

        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "endpoint_y"
        },

        {
          "calculate": "datum.side === 'source_x' ? datum.endpoint_y : null",
          "as": "source_y_value"
        },

        {
          "calculate": "datum.side === 'target_x' ? datum.endpoint_y : null",
          "as": "target_y_value"
        },

        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "source_y_value",
              "as": "source_y"
            },
            {
              "op": "max",
              "field": "target_y_value",
              "as": "target_y"
            }
          ],
          "groupby": [
            "link_id"
          ]
        },

        {
          "filter": "datum.side === 'source_x'"
        },

        {
          "calculate": "[0,0.05,0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.45,0.5,0.55,0.6,0.65,0.7,0.75,0.8,0.85,0.9,0.95,1]",
          "as": "path_positions"
        },

        {
          "flatten": [
            "path_positions"
          ],
          "as": [
            "path_x"
          ]
        },

        {
          "calculate": "datum.path_x * datum.path_x * (3 - 2 * datum.path_x)",
          "as": "smooth_step"
        },

        {
          "calculate": "datum.source_y + (datum.target_y - datum.source_y) * datum.smooth_step",
          "as": "path_y"
        },

        {
          "calculate": "datum.game_count / datum.all_associations * 480",
          "as": "flow_width_px"
        }
      ],

      "mark": {
        "type": "line",
        "opacity": 0.62,
        "strokeCap": "butt",
        "strokeJoin": "round",
        "interpolate": "monotone"
      },

      "encoding": {

        "x": {
          "field": "path_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },

        "y": {
          "field": "path_y",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },

        "detail": {
          "field": "link_id",
          "type": "nominal"
        },

        "order": {
          "field": "path_x",
          "type": "quantitative",
          "sort": "ascending"
        },

        "strokeWidth": {
          "field": "flow_width_px",
          "type": "quantitative",
          "scale": null,
          "legend": null
        },

        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "rating",
            "type": "nominal",
            "title": "ESRB Rating"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "Distinct Titles",
            "format": ",d"
          },
          {
            "field": "genre_share",
            "type": "quantitative",
            "title": "Share Within Genre",
            "format": ".1%"
          },
          {
            "field": "rating_share",
            "type": "quantitative",
            "title": "Share Within Rating",
            "format": ".1%"
          },
          {
            "field": "association_share",
            "type": "quantitative",
            "title": "Share of All Associations",
            "format": ".1%"
          }
        ]
      }
    },

    {
      "transform": [

        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "genre",
            "genre_order"
          ]
        },

        {
          "stack": "node_total",
          "sort": [
            {
              "field": "genre_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        }
      ],

      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {

        "x": {
          "datum": -0.012,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },

        "x2": {
          "datum": 0.012
        },

        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },

        "y2": {
          "field": "y1"
        },

        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "node_total",
            "type": "quantitative",
            "title": "Total Associations",
            "format": ",d"
          }
        ]
      }
    },

    {
      "transform": [

        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "rating",
            "rating_order"
          ]
        },

        {
          "stack": "node_total",
          "sort": [
            {
              "field": "rating_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        }
      ],

      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {

        "x": {
          "datum": 0.988,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },

        "x2": {
          "datum": 1.012
        },

        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },

        "y2": {
          "field": "y1"
        },

        "color": {
          "field": "rating",
          "type": "nominal",
          "scale": {
            "domain": [
              "E",
              "E10+",
              "T",
              "M"
            ],
            "range": [
              "#56B4E9",
              "#E6AB02",
              "#E67E22",
              "#CC79A7"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "rating",
            "type": "nominal",
            "title": "ESRB Rating"
          },
          {
            "field": "node_total",
            "type": "quantitative",
            "title": "Total Associations",
            "format": ",d"
          }
        ]
      }
    },

    {
      "transform": [

        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "genre",
            "genre_order"
          ]
        },

        {
          "stack": "node_total",
          "sort": [
            {
              "field": "genre_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        },

        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "node_mid"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -13,
        "fontSize": 11.5,
        "fontWeight": "bold"
      },

      "encoding": {

        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },

        "y": {
          "field": "node_mid",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "genre"
        },

        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        }
      }
    },

    {
      "transform": [

        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "rating",
            "rating_order"
          ]
        },

        {
          "stack": "node_total",
          "sort": [
            {
              "field": "rating_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        },

        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "node_mid"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 13,
        "fontSize": 11.5,
        "fontWeight": "bold"
      },

      "encoding": {

        "x": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },

        "y": {
          "field": "node_mid",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "rating"
        },

        "color": {
          "field": "rating",
          "type": "nominal",
          "scale": {
            "domain": [
              "E",
              "E10+",
              "T",
              "M"
            ],
            "range": [
              "#56B4E9",
              "#E6AB02",
              "#E67E22",
              "#CC79A7"
            ]
          },
          "legend": null
        }
      }
    }
  ],

  "resolve": {
    "scale": {
      "color": "independent"
    }
  },

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}