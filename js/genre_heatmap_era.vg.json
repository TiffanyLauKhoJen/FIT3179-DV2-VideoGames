{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Heatmap of genre composition across five-year release eras using distinct titles and earliest recorded release year.",
  "width": 760,
  "height": 390,
  "background": "white",
  "title": {
    "text": "How Has the Genre Mix of Recorded Video Game Releases Changed Across Eras?",
    "subtitle": [
      "Share of distinct titles among 10 major genres, grouped by earliest recorded release year.",
      "Five-year eras reduce annual noise; multiplatform records are collapsed to one title."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666",
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/dataset_g2_genre_era_heatmap.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Era_order": "number",
        "Genre_order": "number",
        "Distinct_title_count": "number",
        "Era_distinct_titles": "number",
        "Genre_share_pct": "number"
      }
    }
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "Era",
      "type": "ordinal",
      "sort": {
        "field": "Era_order",
        "order": "ascending"
      },
      "title": "Release Era",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelPadding": 7
      }
    },
    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": "Genre",
      "sort": [
        "Action",
        "Adventure",
        "Role-Playing (RPG)",
        "Sports",
        "Shooter",
        "Strategy",
        "Puzzle",
        "Simulation",
        "Platformer",
        "Racing"
      ],
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 12,
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "Genre_share_pct",
      "type": "quantitative",
      "title": [
        "Share within",
        "selected genres (%)"
      ],
      "scale": {
        "scheme": "blues",
        "domain": [
          0,
          55
        ]
      },
      "legend": {
        "gradientLength": 210,
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "tooltip": [
      {
        "field": "Era",
        "type": "ordinal",
        "title": "Release era"
      },
      {
        "field": "Genre",
        "type": "nominal",
        "title": "Genre"
      },
      {
        "field": "Distinct_title_count",
        "type": "quantitative",
        "title": "Distinct titles in genre",
        "format": ",d"
      },
      {
        "field": "Era_distinct_titles",
        "type": "quantitative",
        "title": "Distinct titles in era",
        "format": ",d"
      },
      {
        "field": "Genre_share_pct",
        "type": "quantitative",
        "title": "Share of selected genres",
        "format": ".1f"
      },
      {
        "field": "Coverage",
        "type": "nominal",
        "title": "Coverage"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#222222",
      "titleColor": "#111111"
    },
    "legend": {
      "labelColor": "#222222",
      "titleColor": "#111111"
    }
  }
}