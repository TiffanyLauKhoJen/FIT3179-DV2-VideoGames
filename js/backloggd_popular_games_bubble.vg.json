{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bubble plot comparing plays and backlog share for the 100 Backloggd games with the largest combined played-plus-backlogged audience.",
  "width": 740,
  "height": 430,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/backloggd_popular_games_bubble.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "plays": "number",
        "backlogs": "number",
        "wishlists": "number",
        "currently_playing": "number",
        "ratings": "number",
        "average_rating": "number",
        "reviews": "number",
        "audience_interest": "number",
        "backlog_share_pct": "number",
        "popularity_rank": "number"
      }
    }
  },
  "title": {
    "text": "Which Popular Games Have Been Played—and Which Remain Backlogged?",
    "subtitle": [
      "Top 100 games by combined Plays + Backlogs in the Backloggd November 2025 snapshot.",
      "Bubble size shows wishlists; dashed lines divide the games at the displayed medians."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "subtitlePadding": 6
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "median",
          "field": "plays",
          "as": "median_plays"
        },
        {
          "op": "median",
          "field": "backlog_share_pct",
          "as": "median_backlog_share"
        }
      ]
    },
    {
      "calculate": "datum.plays >= datum.median_plays ? (datum.backlog_share_pct >= datum.median_backlog_share ? 'Widely played, high backlog' : 'Widely played, lower backlog') : (datum.backlog_share_pct >= datum.median_backlog_share ? 'Less played, high backlog' : 'Less played, lower backlog')",
      "as": "position_group"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#777777",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "median_plays",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#777777",
        "strokeDash": [
          5,
          5
        ],
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "median_backlog_share",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "plays",
          "type": "quantitative",
          "title": "Backloggd users who marked the game as played",
          "scale": {
            "zero": false,
            "nice": true
          },
          "axis": {
            "format": "~s",
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },
        "y": {
          "field": "backlog_share_pct",
          "type": "quantitative",
          "title": "Backlog share of played + backlogged users (%)",
          "scale": {
            "domain": [
              0,
              45
            ]
          },
          "axis": {
            "format": ".0f",
            "tickCount": 6,
            "grid": true,
            "gridColor": "#eeeeee"
          }
        },
        "size": {
          "field": "wishlists",
          "type": "quantitative",
          "title": "Wishlists",
          "scale": {
            "range": [
              35,
              950
            ]
          },
          "legend": {
            "orient": "right",
            "format": "~s",
            "values": [
              2000,
              8000,
              16000
            ]
          }
        },
        "color": {
          "field": "position_group",
          "type": "nominal",
          "title": "Relative position",
          "scale": {
            "domain": [
              "Widely played, high backlog",
              "Widely played, lower backlog",
              "Less played, high backlog",
              "Less played, lower backlog"
            ],
            "range": [
              "#7B61A8",
              "#3B82A0",
              "#D9822B",
              "#9AA3AA"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "title",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "developer",
            "type": "nominal",
            "title": "Developer"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Release year",
            "format": ".0f"
          },
          {
            "field": "plays",
            "type": "quantitative",
            "title": "Plays",
            "format": ",.0f"
          },
          {
            "field": "backlogs",
            "type": "quantitative",
            "title": "Backlogs",
            "format": ",.0f"
          },
          {
            "field": "backlog_share_pct",
            "type": "quantitative",
            "title": "Backlog share (%)",
            "format": ".1f"
          },
          {
            "field": "wishlists",
            "type": "quantitative",
            "title": "Wishlists",
            "format": ",.0f"
          },
          {
            "field": "currently_playing",
            "type": "quantitative",
            "title": "Currently playing",
            "format": ",.0f"
          },
          {
            "field": "average_rating",
            "type": "quantitative",
            "title": "Average rating",
            "format": ".1f"
          },
          {
            "field": "ratings",
            "type": "quantitative",
            "title": "Ratings",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label_text !== ''"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 7,
        "dy": -7,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "plays",
          "type": "quantitative"
        },
        "y": {
          "field": "backlog_share_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "label_text",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 13,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
