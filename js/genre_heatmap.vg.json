{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 850,
  "height": 360,

  "title": {
    "text": "How Has the Genre Mix of Recorded Video Game Releases Changed?",
    "subtitle": [
      "Genre share of title-console release records by year, 1980–2024"
    ],
    "anchor": "start"
  },

  "data": {
    "url":"https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/refs/heads/main/data/dataset_g2_sales_genre_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Genre_order": "number",
        "Genre_count": "number",
        "Year_release_records": "number",
        "Genre_share_pct": "number"
      }
    }
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.5
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Release Year",
      "axis": {
        "values": [
          1980,
          1985,
          1990,
          1995,
          2000,
          2005,
          2010,
          2015,
          2020,
          2024
        ],
        "labelAngle": 0
      }
    },

    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": "Genre",
      "sort": [
        "Action",
        "Adventure",
        "Sports",
        "Role-Playing (RPG)",
        "Shooter",
        "Platformer",
        "Strategy",
        "Puzzle",
        "Racing",
        "Simulation",
        "Fighting",
        "Action-Adventure"
      ]
    },

    "color": {
      "field": "Genre_share_pct",
      "type": "quantitative",
      "title": "Share of Releases (%)",
      "scale": {
        "scheme": "blues",
        "domain": [0, 25],
        "clamp": true
      }
    },

    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Genre",
        "type": "nominal",
        "title": "Genre"
      },
      {
        "field": "Genre_count",
        "type": "quantitative",
        "title": "Release records in genre",
        "format": ",d"
      },
      {
        "field": "Year_release_records",
        "type": "quantitative",
        "title": "All release records that year",
        "format": ",d"
      },
      {
        "field": "Genre_share_pct",
        "type": "quantitative",
        "title": "Share of releases",
        "format": ".1f"
      },
      {
        "field": "Coverage",
        "type": "nominal",
        "title": "Coverage note"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },

    "legend": {
      "titleFontSize": 11,
      "labelFontSize": 10,
      "gradientLength": 180
    }
  }
}