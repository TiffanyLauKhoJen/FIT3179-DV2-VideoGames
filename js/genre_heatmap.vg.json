{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 420,

  "title": {
    "text": "Which Themes Distinguish Major Video Game Genres?",
    "subtitle": [
      "Difference from the overall theme rate among IGDB main games with both genre and theme data, 1980–2025",
      "Blue = more common within the genre; red = less common within the genre"
    ],
    "anchor": "start"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/dataset_g2_genre_theme.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Genre_order": "number",
        "Theme_order": "number",
        "Pair_count": "number",
        "Genre_theme_coded_games": "number",
        "All_genre_theme_coded_games": "number",
        "Theme_pct_within_genre": "number",
        "Theme_baseline_pct": "number",
        "Association_pp": "number",
        "Association_ratio": "number"
      }
    }
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "Theme",
      "type": "nominal",
      "title": "Theme",
      "sort": [
        "Action",
        "Fantasy",
        "Science fiction",
        "Horror",
        "Comedy",
        "Erotic",
        "Mystery",
        "Kids",
        "Romance",
        "Survival",
        "Educational",
        "Historical"
      ],
      "axis": {
        "labelAngle": -35,
        "labelLimit": 120
      }
    },

    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": "Genre",
      "sort": [
        "Indie",
        "Adventure",
        "Role-playing (RPG)",
        "Simulator",
        "Strategy",
        "Arcade",
        "Puzzle",
        "Shooter",
        "Platformer",
        "Visual Novel",
        "Sport",
        "Racing"
      ]
    },

    "color": {
      "field": "Association_pp",
      "type": "quantitative",
      "title": "Difference from overall rate (pp)",
      "scale": {
        "scheme": "redblue",
        "domain": [-55, 55]
      }
    },

    "tooltip": [
      {
        "field": "Genre",
        "type": "nominal",
        "title": "Genre"
      },
      {
        "field": "Theme",
        "type": "nominal",
        "title": "Theme"
      },
      {
        "field": "Pair_count",
        "type": "quantitative",
        "title": "Games with this pairing",
        "format": ",d"
      },
      {
        "field": "Genre_theme_coded_games",
        "type": "quantitative",
        "title": "Games in genre with theme data",
        "format": ",d"
      },
      {
        "field": "Theme_pct_within_genre",
        "type": "quantitative",
        "title": "% of genre tagged with theme",
        "format": ".1f"
      },
      {
        "field": "Theme_baseline_pct",
        "type": "quantitative",
        "title": "Overall theme rate (%)",
        "format": ".1f"
      },
      {
        "field": "Association_pp",
        "type": "quantitative",
        "title": "Difference (percentage points)",
        "format": "+.1f"
      },
      {
        "field": "Association_ratio",
        "type": "quantitative",
        "title": "Relative association",
        "format": ".2f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },

    "legend": {
      "titleFontSize": 11,
      "labelFontSize": 10,
      "gradientLength": 180
    }
  }
}