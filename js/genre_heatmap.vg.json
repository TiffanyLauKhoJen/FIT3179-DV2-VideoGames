{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 380,

  "title": {
    "text": "How Has the Video Game Genre Landscape Changed?",
    "subtitle": "Share of genre-coded main games represented in IGDB across 5-year periods, 1980–2024",
    "anchor": "start"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/dataset_g2_5year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Period_order": "number",
        "Genre_rank": "number",
        "Genre_count": "number",
        "Genre_coded_games": "number",
        "Total_main_games": "number",
        "Genre_share_pct": "number"
      }
    }
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "Period",
      "type": "ordinal",
      "title": "Gaming Period",
      "sort": [
        "1980–84",
        "1985–89",
        "1990–94",
        "1995–99",
        "2000–04",
        "2005–09",
        "2010–14",
        "2015–19",
        "2020–24"
      ],
      "axis": {
        "labelAngle": 0
      }
    },

    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": "Genre",
      "sort": [
        "Indie",
        "Adventure",
        "Simulator",
        "Strategy",
        "Role-playing (RPG)",
        "Puzzle",
        "Arcade",
        "Shooter",
        "Platformer",
        "Sport",
        "Visual Novel",
        "Racing"
      ]
    },

    "color": {
      "field": "Genre_share_pct",
      "type": "quantitative",
      "title": "% of Games",
      "scale": {
        "type": "threshold",
        "domain": [5, 10, 20, 30, 50],
        "range": [
          "#f7fbff",
          "#deebf7",
          "#c6dbef",
          "#9ecae1",
          "#4292c6",
          "#08519c"
        ]
      }
    },

    "tooltip": [
      {
        "field": "Period",
        "type": "ordinal",
        "title": "Period"
      },
      {
        "field": "Genre",
        "type": "nominal",
        "title": "Genre"
      },
      {
        "field": "Genre_count",
        "type": "quantitative",
        "title": "Games with Genre",
        "format": ",d"
      },
      {
        "field": "Genre_coded_games",
        "type": "quantitative",
        "title": "Games with Genre Data",
        "format": ",d"
      },
      {
        "field": "Genre_share_pct",
        "type": "quantitative",
        "title": "% of Games",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },

    "legend": {
      "titleFontSize": 12,
      "labelFontSize": 11
    }
  }
}