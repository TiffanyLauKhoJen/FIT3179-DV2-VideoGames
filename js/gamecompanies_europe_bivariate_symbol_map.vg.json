{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which European markets lean toward game publishing?",
    "subtitle": "Europe and nearby markets · 31 locations with at least 10 combined GameCompanies listings"
  },
  "width": 800,
  "height": 500,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_50m_admin_0_countries.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9EEF1",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.longitude >= -12 && datum.longitude <= 46 && datum.latitude >= 34 && datum.latitude <= 72"
        },
        {
          "calculate": "datum.developed_games + datum.published_games",
          "as": "combined_listings"
        },
        {"filter": "datum.combined_listings >= 10"},
        {
          "calculate": "datum.published_games / datum.combined_listings",
          "as": "publishing_share"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#25313A",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "order": {
          "field": "combined_listings",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "combined_listings",
          "type": "quantitative",
          "title": "Development + publishing listings",
          "scale": {
            "type": "linear",
            "domain": [0, 6700],
            "range": [44, 1700]
          },
          "legend": {"orient": "right", "format": ",.0f"}
        },
        "color": {
          "field": "publishing_share",
          "type": "quantitative",
          "title": "Publishing share",
          "scale": {
            "domain": [0, 0.5, 1],
            "range": ["#2F80ED", "#D6DDE2", "#E78833"]
          },
          "legend": {"orient": "right", "format": ".0%"}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Location"},
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          },
          {
            "field": "combined_listings",
            "type": "quantitative",
            "title": "Combined listings",
            "format": ",.0f"
          },
          {
            "field": "publishing_share",
            "type": "quantitative",
            "title": "Publishing share",
            "format": ".0%"
          }
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
