{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Genre mix of five selected publishers across five selected genres, from Video Games Sales (1980–2024) – Raw. Includes records with release dates in 1980–2024. Each distinct publisher–title–genre combination is counted once across platforms. Simulation is displayed as Simulator. Publishers are selected for contrasting profiles, not a top-five ranking. Width represents selected title–genre pairs; height represents genre share within each publisher. Sales values are not used.",
  "width": 539,
  "height": 297,
  "padding": {
    "left": 10,
    "right": 20,
    "top": 10,
    "bottom": 8
  },
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_genre_marimekko_5x5.csv",
    "format": {
      "type": "csv",
      "parse": {
        "distinct_title_count": "number"
      }
    }
  },
  "title": {
    "text": "Genre Mix of Selected Video Game Publishers",
    "anchor": "start",
    "fontSize": 17,
    "offset": 12
  },
  "transform": [
    {
      "calculate": "datum.publisher",
      "as": "publisher_label"
    },
    {
      "calculate": "indexof(['Sports','Action','Shooter','Role-Playing','Simulator'], datum.genre)",
      "as": "genre_order"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "distinct_title_count",
          "as": "publisher_total"
        }
      ],
      "groupby": [
        "publisher"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "distinct_title_count",
          "as": "displayed_total"
        }
      ]
    },
    {
      "calculate": "datum.distinct_title_count / datum.publisher_total",
      "as": "genre_share_within_publisher"
    },
    {
      "calculate": "datum.publisher_total / datum.displayed_total",
      "as": "publisher_share_of_displayed"
    },
    {
      "stack": "distinct_title_count",
      "groupby": [],
      "as": [
        "x_stack_start",
        "x_stack_end"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "publisher_total",
          "order": "descending"
        },
        {
          "field": "publisher",
          "order": "ascending"
        },
        {
          "field": "genre_order",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "min",
          "field": "x_stack_start",
          "as": "x0"
        },
        {
          "op": "max",
          "field": "x_stack_end",
          "as": "x1"
        }
      ],
      "groupby": [
        "publisher"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "stack": "distinct_title_count",
      "groupby": [
        "publisher"
      ],
      "as": [
        "y0",
        "y1"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "genre_order",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "title": "Genre share within each publisher",
            "format": ".0%",
            "values": [
              0,
              0.2,
              0.4,
              0.6,
              0.8,
              1
            ],
            "grid": true,
            "gridColor": "#E5E7EB",
            "domain": false
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "title": "Genre",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Role-Playing",
              "Simulator"
            ],
            "range": [
              "#393B79",
              "#E78AC3",
              "#790606",
              "#B15928",
              "#6A3D9A"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "offset": 45,
            "labelFontSize": 11,
            "titleFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "publisher",
            "type": "nominal",
            "title": "Publisher"
          },
          {
            "field": "publisher_total",
            "type": "quantitative",
            "title": "Selected Title–Genre Pairs",
            "format": ",d"
          },
          {
            "field": "publisher_share_of_displayed",
            "type": "quantitative",
            "title": "Publisher Share of Displayed Total",
            "format": ".1%"
          },
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "distinct_title_count",
            "type": "quantitative",
            "title": "Distinct Titles",
            "format": ",d"
          },
          {
            "field": "genre_share_within_publisher",
            "type": "quantitative",
            "title": "Genre Share Within Publisher",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.genre_order === 0"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "align": "center",
        "dy": 12,
        "fontSize": 11,
        "fontWeight": "bold",
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "text": {
          "field": "publisher_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
