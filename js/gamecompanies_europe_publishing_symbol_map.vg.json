{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are GameCompanies publishing listings concentrated?",
    "subtitle": "Europe and nearby locations · England, France, Germany and Poland hold 72% of mapped listings"
  },
  "width": 760,
  "height": 500,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_50m_admin_0_countries.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F2F3",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.longitude >= -12 && datum.longitude <= 46 && datum.latitude >= 34 && datum.latitude <= 72"},
        {"filter": "isValid(datum.published_games) && datum.published_games > 0"}
      ],
      "mark": {
        "type": "circle",
        "color": "#D85A31",
        "opacity": 0.78,
        "stroke": "#8E351E",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "order": {"field": "published_games", "type": "quantitative", "sort": "descending"},
        "size": {
          "field": "published_games",
          "type": "quantitative",
          "title": "Publishing listings",
          "scale": {"type": "linear", "domain": [0, 4000], "range": [0, 2500]},
          "legend": {"orient": "right", "values": [500, 2000, 4000], "format": ",.0f"}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Location"},
          {"field": "published_games", "type": "quantitative", "title": "Publishing listings", "format": ",.0f"},
          {"field": "developed_games", "type": "quantitative", "title": "Development listings", "format": ",.0f"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {"filter": "indexof(['England', 'France', 'Germany', 'Poland'], datum.country) >= 0"}
      ],
      "mark": {
        "type": "text",
        "dy": -34,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#23313B"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "country", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
