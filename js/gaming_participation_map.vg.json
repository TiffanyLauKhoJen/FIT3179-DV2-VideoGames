{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Is Video Game Participation Highest?"
  },
  "width": 1020,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "center_to"
    },
    "scale": {
      "expr": "zoom_level"
    }
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "'No mapped survey data for ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "clip": true
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "type": "nominal"
        },
        "color": {
          "datum": "No data",
          "type": "nominal",
          "scale": {
            "range": [
              "lightgray"
            ]
          },
          "legend": {
            "orient": "none",
            "title": null,
            "symbolType": "square",
            "symbolSize": 200,
            "symbolStrokeColor": "#9AA1AD",
            "symbolStrokeWidth": 0.5,
            "labelFontSize": 12,
            "legendX": 222,
            "legendY": 535
          }
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray",
        "clip": true
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gaming_participation_apr2024.csv"
            },
            "key": "Country",
            "fields": [
              "ParticipationPct"
            ]
          }
        },
        {
          "filter": "isValid(datum.ParticipationPct)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "ParticipationPct",
          "type": "quantitative",
          "title": "Play video games (%)",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          },
          "scale": {
            "type": "threshold",
            "domain": [
              80,
              85,
              90
            ],
            "range": [
              "#C2E699",
              "#78C679",
              "#31A354",
              "#006837"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "ParticipationPct",
            "type": "quantitative",
            "title": "Play video games (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Vietnam",
            "lon": 125,
            "lat": 22,
            "align": "left",
            "lineLon": 124.4,
            "lineLat": 21.7,
            "toLon": 108,
            "toLat": 14.5
          },
          {
            "name": "Philippines",
            "lon": 132,
            "lat": 13,
            "align": "left",
            "lineLon": 131.4,
            "lineLat": 13,
            "toLon": 123,
            "toLat": 12
          },
          {
            "name": "Indonesia",
            "lon": 113,
            "lat": -16,
            "align": "center",
            "lineLon": 113,
            "lineLat": -14.3,
            "toLon": 111,
            "toLat": -7.6
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#000000",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lineLon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lineLat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "toLon"
        },
        "latitude2": {
          "field": "toLat"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Vietnam",
            "lon": 125,
            "lat": 22
          },
          {
            "name": "Philippines",
            "lon": 132,
            "lat": 13
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#000000",
        "baseline": "middle",
        "align": "left",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Indonesia",
            "lon": 113,
            "lat": -16
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#000000",
        "baseline": "middle",
        "align": "center",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "subtitleColor": "#526274"
    }
  },
  "resolve": {
    "scale": {
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 188,
      "bind": {
        "input": "range",
        "min": 188,
        "max": 1200,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            0
          ],
          [
            110,
            5
          ],
          [
            10,
            50
          ],
          [
            -60,
            0
          ],
          [
            -98,
            40
          ]
        ],
        "labels": [
          "World",
          "Southeast Asia",
          "Europe",
          "South America",
          "North America"
        ],
        "name": "Map Centre: "
      }
    }
  ]
}
