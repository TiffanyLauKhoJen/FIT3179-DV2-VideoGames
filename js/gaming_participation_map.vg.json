{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where is video-game participation most widespread?",
    "subtitle": [
      "Share of internet users aged 16–64 who play video games on any device",
      "Selected countries · April 2024 · Grey: no mapped survey data"
    ]
  },
  "width": 760,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray"
      }
    },
    {
      "transform": [
        {
          "calculate": "'No mapped survey data for ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white",
        "strokeWidth": 0.4
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gaming_participation_apr2024.csv"
            },
            "key": "Country",
            "fields": [
              "ParticipationPct"
            ]
          }
        },
        {
          "filter": "isValid(datum.ParticipationPct)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "ParticipationPct",
          "type": "quantitative",
          "title": "Play video games (%)",
          "legend": {
            "orient": "right"
          },
          "scale": {
            "type": "threshold",
            "domain": [
              80,
              85,
              90
            ],
            "range": [
              "#C6DBEF",
              "#9ECAE1",
              "#4292C6",
              "#084594"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "ParticipationPct",
            "type": "quantitative",
            "title": "Play video games (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "subtitleColor": "#526274"
    }
  }
}
