{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual counts of seven selected IGDB genre tags among main games. Games can have multiple tags.",
  "width": 820,
  "height": 420,
  "background": "white",
  "title": {
    "text": "How Have IGDB-Listed Game Releases Shifted Across Genres?",
    "subtitle": [
      "1980–2024 · Main games · Annual counts across seven selected genre tags",
      "A game can appear in multiple genres. Action is a theme, not a genre, in this dataset."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_release_composition_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Game_count": "number",
        "Selected_genre_assignments": "number",
        "Share_pct": "number",
        "All_main_game_releases": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['Sports', 'Shooter', 'Racing', 'Role-Playing', 'Fighting', 'Adventure', 'Platform'], datum.Genre)",
      "as": "Genre_order"
    }
  ],
  "mark": {"type": "area", "opacity": 0.94, "interpolate": "linear", "clip": true},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Earliest Recorded Release Year",
      "scale": {"domain": [1980, 2024], "nice": false},
      "axis": {
        "values": [1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2024],
        "format": "d",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "Game_count",
      "type": "quantitative",
      "stack": "zero",
      "title": "Number of Genre-Tagged Game Releases",
      "axis": {"format": ",.0f", "grid": true, "gridColor": "#E5E7EB", "domain": false}
    },
    "color": {
      "field": "Genre",
      "type": "nominal",
      "title": "Genre",
      "sort": ["Sports", "Shooter", "Racing", "Role-Playing", "Fighting", "Adventure", "Platform"],
      "scale": {
        "domain": ["Sports", "Shooter", "Racing", "Role-Playing", "Fighting", "Adventure", "Platform"],
        "range": ["#2A9D8F", "#3A86FF", "#F4A261", "#8338EC", "#E9C46A", "#5C677D", "#6A994E"]
      },
      "legend": {"orient": "bottom", "columns": 4, "labelFontSize": 11, "titleFontSize": 11}
    },
    "order": {"field": "Genre_order", "type": "quantitative", "sort": "ascending"},
    "tooltip": [
      {"field": "Year", "type": "quantitative", "title": "Release year", "format": "d"},
      {"field": "Genre", "type": "nominal", "title": "Genre"},
      {"field": "Game_count", "type": "quantitative", "title": "Games tagged with genre", "format": ",.0f"},
      {"field": "Share_pct", "type": "quantitative", "title": "Share of seven tags (%)", "format": ".1f"},
      {"field": "Selected_genre_assignments", "type": "quantitative", "title": "Seven-genre assignments", "format": ",.0f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "font": "Arial",
    "axis": {"labelFontSize": 11, "titleFontSize": 12},
    "legend": {"symbolType": "square"}
  }
}
