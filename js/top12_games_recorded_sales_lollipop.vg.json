{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal lollipop chart of the top 12 game titles by summed recorded platform-level sales in the Video Games Sales 1980-2024 dataset.",
  "width": 660,
  "height": 430,

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/top12_games_recorded_sales_lollipop.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "recorded_total_sales_millions": "number",
        "platforms_with_reported_sales": "number",
        "earliest_recorded_release_year": "number",
        "reported_platform_rows": "number"
      }
    }
  },

  "title": {
    "text": "Which Games Have the Highest Recorded Sales?",
    "subtitle": [
      "Top 12 individual game titles by summed reported sales across platform records."
    ],
    "anchor": "start"
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#B8B8B8"
      },
      "encoding": {
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "recorded_total_sales_millions",
            "op": "sum",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 250,
            "labelFontSize": 11
          }
        },

        "x": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          },
          "title": "Recorded Total Sales (Millions)"
        },

        "x2": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 135
      },
      "encoding": {
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "recorded_total_sales_millions",
            "op": "sum",
            "order": "descending"
          }
        },

        "x": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          }
        },

        "tooltip": [
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": "d"
          },
          {
            "field": "title",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "recorded_total_sales_millions",
            "type": "quantitative",
            "title": "Recorded Sales (M)",
            "format": ".2f"
          },
          {
            "field": "platforms_with_reported_sales",
            "type": "quantitative",
            "title": "Platforms with Reported Sales",
            "format": "d"
          },
          {
            "field": "earliest_recorded_release_year",
            "type": "quantitative",
            "title": "Earliest Recorded Release",
            "format": "d"
          },
          {
            "field": "dominant_genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "dominant_publisher",
            "type": "nominal",
            "title": "Publisher"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11
      },
      "encoding": {
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "recorded_total_sales_millions",
            "op": "sum",
            "order": "descending"
          }
        },

        "x": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "scale": {
            "domain": [0, 70]
          }
        },

        "text": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "grid": true
    },

    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}