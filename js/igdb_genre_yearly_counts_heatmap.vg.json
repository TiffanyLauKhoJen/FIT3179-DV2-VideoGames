{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How did recorded game counts change across genres?",
    "subtitle": "IGDB main games released in 1980-2024 · One game can have multiple genre tags"
  },
  "width": 900,
  "height": 340,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_release_composition_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Game_count": "number",
        "All_main_game_releases": "number"
      }
    }
  },
  "mark": {"type": "rect", "stroke": "white", "strokeWidth": 0.35},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Release year",
      "sort": "ascending",
      "axis": {
        "values": [1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2024],
        "labelAngle": 0,
        "labelOverlap": false,
        "grid": false,
        "tickSize": 0
      }
    },
    "y": {
      "field": "Genre",
      "type": "nominal",
      "title": null,
      "sort": ["Sports", "Shooter", "Racing", "Role-Playing", "Fighting", "Adventure", "Platform"],
      "axis": {"ticks": false, "domain": false, "labelPadding": 8}
    },
    "color": {
      "field": "Game_count",
      "type": "quantitative",
      "title": "Recorded games",
      "scale": {
        "type": "sqrt",
        "domain": [0, 7000],
        "range": ["#F1F6FB", "#08519C"]
      },
      "legend": {
        "orient": "right",
        "values": [0, 250, 1000, 2500, 5000, 7000],
        "format": ",.0f",
        "gradientLength": 230
      }
    },
    "tooltip": [
      {"field": "Year", "type": "ordinal", "title": "Release year"},
      {"field": "Genre", "type": "nominal", "title": "Genre"},
      {"field": "Game_count", "type": "quantitative", "title": "Games tagged with genre", "format": ",.0f"},
      {"field": "All_main_game_releases", "type": "quantitative", "title": "All recorded main-game releases", "format": ",.0f"}
    ]
  },
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12},
    "legend": {"labelFontSize": 11, "titleFontSize": 11}
  }
}
