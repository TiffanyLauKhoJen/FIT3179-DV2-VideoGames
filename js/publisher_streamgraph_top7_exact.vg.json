{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph showing annual release activity for the seven exact publisher labels with the most distinct titles in the Video Game Sales 1980\u20132024 collection.",
  "width": 720,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_streamgraph_top7_exact.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "publisher_rank": "number",
        "publisher_total_distinct_titles": "number",
        "distinct_titles": "number",
        "selected_publishers_total_titles": "number",
        "share_selected_publishers_pct": "number"
      }
    }
  },
  "title": {
    "text": "How Has Release Activity Shifted Among the Top 7 Publishers?",
    "subtitle": [
      "Top 7 exact publisher labels ranked by distinct titles in the collection.",
      "Stream thickness shows annual distinct titles; multiplatform titles are counted once at their earliest recorded release year."
    ],
    "anchor": "start"
  },
  "params": [
    {
      "name": "publisher_hover",
      "select": {
        "type": "point",
        "fields": [
          "publisher"
        ],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Release Year",
      "scale": {
        "zero": false,
        "domain": [
          1980,
          2024
        ]
      },
      "axis": {
        "format": "d",
        "tickCount": 10,
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "distinct_titles",
      "type": "quantitative",
      "stack": "center",
      "title": null,
      "axis": null
    },
    "color": {
      "field": "publisher",
      "type": "nominal",
      "title": "Publisher",
      "sort": {
        "field": "publisher_rank",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 4,
        "labelLimit": 190
      }
    },
    "order": {
      "field": "publisher_rank",
      "type": "quantitative",
      "sort": "ascending"
    },
    "opacity": {
      "condition": {
        "param": "publisher_hover",
        "value": 1,
        "empty": false
      },
      "value": 0.72
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "publisher",
        "type": "nominal",
        "title": "Publisher"
      },
      {
        "field": "publisher_rank",
        "type": "quantitative",
        "title": "Overall Rank",
        "format": "d"
      },
      {
        "field": "publisher_total_distinct_titles",
        "type": "quantitative",
        "title": "Total Distinct Titles",
        "format": ",d"
      },
      {
        "field": "distinct_titles",
        "type": "quantitative",
        "title": "Titles Released This Year",
        "format": ",d"
      },
      {
        "field": "share_selected_publishers_pct",
        "type": "quantitative",
        "title": "Share of Top 7 This Year",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}