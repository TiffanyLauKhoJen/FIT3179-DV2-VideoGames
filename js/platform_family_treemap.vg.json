{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Vega hierarchical treemap of 35 selected platforms in seven families, counting distinct main-game ID–platform pairs released in 1980–2025. A game supported on multiple platforms contributes to multiple rectangles. The CSV contains only family, platform and game_count. The nest and treemap transforms calculate layout coordinates at runtime. Full tooltip names and compact display labels are defined in this specification. The selected counts total 253,355.",
  "width": 611,
  "height": 360,
  "padding": 5,
  "autosize": "pad",
  "background": "white",
  "title": {
    "text": "Which Platforms Have the Most Games?",
    "anchor": "start",
    "frame": "group",
    "fontSize": 19,
    "offset": 12
  },
  "data": [
    {
      "name": "platforms",
      "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/platform_family_treemap_grouped_1980_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "game_count": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "platform_full_name",
          "expr": "({\"PC (Microsoft Windows)\":\"Microsoft Windows personal computer platform\",\"Mac\":\"Apple Macintosh (Mac)\",\"Linux\":\"Linux\",\"iOS\":\"Apple iPhone operating system\",\"Nintendo Switch\":\"Nintendo Switch\",\"Android\":\"Android\",\"PlayStation 4\":\"PlayStation 4\",\"Xbox One\":\"Xbox One\",\"PlayStation 5\":\"PlayStation 5\",\"Xbox Series X|S\":\"Xbox Series X and Xbox Series S\",\"PlayStation 2\":\"PlayStation 2\",\"DOS\":\"Disk Operating System (DOS)\",\"PlayStation\":\"PlayStation\",\"PlayStation 3\":\"PlayStation 3\",\"Commodore C64/128/MAX\":\"Commodore 64 / Commodore 128 / Commodore MAX\",\"Wii\":\"Wii\",\"Xbox 360\":\"Xbox 360\",\"Nintendo DS\":\"Nintendo DS (dual-screen handheld console)\",\"SteamVR\":\"SteamVR (Steam virtual reality platform)\",\"Nintendo 3DS\":\"Nintendo 3DS (handheld console with a three-dimensional display)\",\"Super Famicom\":\"Super Famicom\",\"Game Boy Advance\":\"Game Boy Advance\",\"Sega Mega Drive/Genesis\":\"Sega Mega Drive / Sega Genesis\",\"Xbox\":\"Xbox\",\"Meta Quest 2\":\"Meta Quest 2\",\"Sega Saturn\":\"Sega Saturn\",\"Dreamcast\":\"Dreamcast\",\"Windows Phone\":\"Windows Phone\",\"Oculus Quest\":\"Oculus Quest\",\"Oculus Rift\":\"Oculus Rift\",\"Sega Master System/Mark III\":\"Sega Master System / Sega Mark III\",\"Oculus VR\":\"Oculus virtual reality (general source platform category)\",\"Sega Game Gear\":\"Sega Game Gear\",\"BlackBerry OS\":\"BlackBerry operating system\",\"Windows Mobile\":\"Windows Mobile\"})[datum.platform] || datum.platform"
        },
        {
          "type": "formula",
          "as": "Display_label",
          "expr": "datum.platform === \"PC (Microsoft Windows)\" ? \"Microsoft Windows\" : (datum.platform === \"Commodore C64/128/MAX\" ? \"Commodore\\nC64 / C128 /\\nMAX\" : (datum.platform === \"Nintendo Switch\" ? \"Nintendo\\nSwitch\" : (datum.platform === \"Nintendo DS\" ? \"Nintendo\\nDS\" : (datum.platform === \"Nintendo 3DS\" ? \"Nintendo\\n3DS\" : (datum.platform === \"Game Boy Advance\" ? \"Game Boy\\nAdvance\" : (datum.platform === \"Super Famicom\" ? \"Super\\nFamicom\" : (datum.platform === \"PlayStation 4\" ? \"PlayStation\\n4\" : (datum.platform === \"PlayStation 5\" ? \"PlayStation\\n5\" : (datum.platform === \"PlayStation 2\" ? \"PlayStation\\n2\" : (datum.platform === \"PlayStation 3\" ? \"PlayStation\\n3\" : (datum.platform === \"Xbox Series X|S\" ? \"Xbox\\nSeries\\nX|S\" : (datum.platform === \"Xbox 360\" ? \"Xbox\\n360\" : (datum.platform === \"Windows Phone\" ? \"Windows\\nPhone\" : (datum.platform === \"BlackBerry OS\" ? \"BlackBerry\\nOS\" : (datum.platform === \"Windows Mobile\" ? \"Windows\\nMobile\" : (datum.platform === \"Meta Quest 2\" ? \"Meta\\nQuest 2\" : (datum.platform === \"Oculus Quest\" ? \"Oculus\\nQuest\" : (datum.platform === \"Oculus Rift\" ? \"Oculus\\nRift\" : (datum.platform === \"Oculus VR\" ? \"Oculus\\nVR\" : (datum.platform === \"Sega Mega Drive/Genesis\" ? \"Mega\\nDrive\" : (datum.platform === \"Sega Saturn\" ? \"Sega\\nSaturn\" : (datum.platform === \"Sega Master System/Mark III\" ? \"Master\\nSystem /\\nMark III\" : (datum.platform === \"Sega Game Gear\" ? \"Sega\\nGame Gear\" : (datum.platform))))))))))))))))))))))))"
        },
        {
          "type": "joinaggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "game_count"
          ],
          "as": [
            "selected_total"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "family"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "game_count"
          ],
          "as": [
            "family_total"
          ]
        },
        {
          "type": "formula",
          "as": "platform_share_selected_pct",
          "expr": "datum.game_count / datum.selected_total * 100"
        },
        {
          "type": "formula",
          "as": "platform_share_family_pct",
          "expr": "datum.game_count / datum.family_total * 100"
        }
      ]
    },
    {
      "name": "tree",
      "source": "platforms",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "family"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "game_count",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": false,
          "method": "squarify",
          "ratio": 1.3,
          "paddingOuter": 0,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 0
        }
      ]
    },
    {
      "name": "families",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        },
        {
          "type": "formula",
          "as": "rect_width",
          "expr": "datum.x1 - datum.x0"
        },
        {
          "type": "formula",
          "as": "rect_height",
          "expr": "datum.y1 - datum.y0"
        },
        {
          "type": "formula",
          "as": "Center_x",
          "expr": "(datum.x0 + datum.x1) / 2"
        },
        {
          "type": "formula",
          "as": "Center_y",
          "expr": "(datum.y0 + datum.y1) / 2"
        },
        {
          "type": "formula",
          "as": "Label_y",
          "expr": "datum.Center_y - 9 - (length(split(datum.Display_label, '\\n')) - 1) * 7"
        },
        {
          "type": "formula",
          "as": "Label_lines",
          "expr": "split(datum.Display_label, '\\n')"
        },
        {
          "type": "formula",
          "as": "Label_width",
          "expr": "max(length(datum.Label_lines[0]), length(datum.Label_lines[1] || \"\"), length(datum.Label_lines[2] || \"\")) * 7 + 12"
        },
        {
          "type": "formula",
          "as": "Label_height",
          "expr": "length(datum.Label_lines) * 14 + 10"
        },
        {
          "type": "formula",
          "as": "Count_text",
          "expr": "format(datum.game_count, ',d') + ' games'"
        },
        {
          "type": "formula",
          "as": "Count_width",
          "expr": "length(datum.Count_text) * (datum.rect_width < 76 ? 5.6 : 6.2) + (datum.rect_width < 76 ? 6 : 12)"
        },
        {
          "type": "formula",
          "as": "Count_y",
          "expr": "datum.Center_y + 9 + (length(datum.Label_lines) - 1) * 7"
        },
        {
          "type": "formula",
          "as": "Label_fits",
          "expr": "datum.rect_width >= max(datum.Label_width, datum.Count_width) && datum.rect_height >= datum.Label_height + 18"
        }
      ]
    },
    {
      "name": "platform_labels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Label_fits"
        }
      ]
    },
    {
      "name": "count_labels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Label_fits"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Computer",
        "Mobile",
        "Nintendo",
        "PlayStation",
        "Xbox",
        "Virtual reality",
        "Sega"
      ],
      "range": [
        "#6484D8",
        "#F28E2B",
        "#8FC4C0",
        "#CD8A90",
        "#D5A06F",
        "#BF8CF2",
        "#FFF084"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Platform Family",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 4,
      "titleFontSize": 12,
      "labelFontSize": 11,
      "symbolType": "square",
      "symbolSize": 100,
      "offset": 14,
      "padding": 0,
      "encode": {
        "symbols": {
          "update": {
            "opacity": {
              "value": 1
            }
          }
        }
      },
      "columnPadding": 14,
      "rowPadding": 4
    }
  ],
  "marks": [
    {
      "description": "One rectangle per platform, coloured by its ecosystem",
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "family"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.4
          },
          "fillOpacity": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "tooltip": {
            "signal": "{'Platform family': datum.family, 'Individual platform': datum.platform_full_name, 'Games on platform': format(datum.game_count, ',d'), 'Share within family (%)': format(datum.platform_share_family_pct, '.1f'), 'Share of selected platforms (%)': format(datum.platform_share_selected_pct, '.1f')}"
          }
        }
      }
    },
    {
      "description": "Dark outline around each ecosystem",
      "type": "rect",
      "from": {
        "data": "families"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#000000"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          }
        }
      }
    },
    {
      "description": "Platform name, only where the rectangle is large enough",
      "type": "text",
      "from": {
        "data": "platform_labels"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "value": "bold"
          },
          "lineHeight": {
            "value": 14
          },
          "lineBreak": {
            "value": "\n"
          },
          "fill": {
            "value": "#111111"
          }
        },
        "update": {
          "x": {
            "field": "Center_x"
          },
          "y": {
            "field": "Label_y"
          },
          "text": {
            "field": "Display_label"
          },
          "fontSize": {
            "signal": "datum.rect_width < 76 ? 10 : 12"
          }
        }
      }
    },
    {
      "description": "Game count under the platform name, only in the largest rectangles",
      "type": "text",
      "from": {
        "data": "count_labels"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Arial"
          },
          "fill": {
            "value": "#222222"
          }
        },
        "update": {
          "x": {
            "field": "Center_x"
          },
          "y": {
            "field": "Count_y"
          },
          "text": {
            "field": "Count_text"
          },
          "limit": {
            "signal": "datum.rect_width - 4"
          },
          "fontSize": {
            "signal": "datum.rect_width < 76 ? 10 : 11"
          }
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
