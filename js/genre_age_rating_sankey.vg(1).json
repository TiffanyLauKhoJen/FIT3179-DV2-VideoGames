{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Sankey-style alluvial diagram linking six major video game genres to standard ESRB age ratings. Flow widths represent distinct title-genre-rating associations.",
  "width": 720,
  "height": 480,
  "padding": {
    "left": 150,
    "right": 125,
    "top": 10,
    "bottom": 10
  },
  "background": "white",
  "title": {
    "text": "How Do Major Video Game Genres Connect to ESRB Age Ratings?",
    "subtitle": [
      "Distinct title–genre–rating associations in Video_Games.csv for six genres used in the sales chart.",
      "Repeated platform records are counted once; missing and non-standard ESRB ratings are excluded."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666",
    "offset": 14
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/genre_age_rating_sankey_clean.csv",
    "format": {
      "type": "csv",
      "parse": {
        "game_count": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof([\"Sports\",\"Action\",\"Shooter\",\"Racing\",\"Role-Playing\",\"Platform\"], datum.genre)",
      "as": "genre_order"
    },
    {
      "calculate": "indexof([\"E\",\"E10+\",\"T\",\"M\"], datum.rating)",
      "as": "rating_order"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "all_associations"
            }
          ]
        },
        {
          "calculate": "datum.game_count / datum.all_associations",
          "as": "association_share"
        },
        {
          "calculate": "datum.genre + ' → ' + datum.rating",
          "as": "link_id"
        },
        {
          "calculate": "0",
          "as": "source_x"
        },
        {
          "calculate": "1",
          "as": "target_x"
        },
        {
          "fold": [
            "source_x",
            "target_x"
          ],
          "as": [
            "side",
            "x"
          ]
        },
        {
          "calculate": "datum.side === 'source_x' ? datum.genre_order * 10 + datum.rating_order : datum.rating_order * 10 + datum.genre_order",
          "as": "stack_order"
        },
        {
          "stack": "game_count",
          "groupby": [
            "x"
          ],
          "sort": [
            {
              "field": "stack_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.62
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "order": {
          "field": "x",
          "type": "quantitative"
        },
        "detail": {
          "field": "link_id",
          "type": "nominal"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "rating",
            "type": "nominal",
            "title": "ESRB rating"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "Distinct titles",
            "format": ",d"
          },
          {
            "field": "association_share",
            "type": "quantitative",
            "title": "Share of displayed links",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "genre",
            "genre_order"
          ]
        },
        {
          "stack": "node_total",
          "sort": [
            {
              "field": "genre_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": -0.012,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },
        "x2": {
          "datum": 0.012
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "node_total",
            "type": "quantitative",
            "title": "Distinct title-rating links",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "rating",
            "rating_order"
          ]
        },
        {
          "stack": "node_total",
          "sort": [
            {
              "field": "rating_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "color": "#5B6470",
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0.988,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },
        "x2": {
          "datum": 1.012
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "field": "rating",
            "type": "nominal",
            "title": "ESRB rating"
          },
          {
            "field": "node_total",
            "type": "quantitative",
            "title": "Distinct title-rating links",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "genre",
            "genre_order"
          ]
        },
        {
          "stack": "node_total",
          "sort": [
            {
              "field": "genre_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "node_mid"
        },
        {
          "calculate": "datum.genre + '  ' + format(datum.node_total, ',d')",
          "as": "node_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -13,
        "fontSize": 11.5,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },
        "y": {
          "field": "node_mid",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "node_label"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports",
              "Action",
              "Shooter",
              "Racing",
              "Role-Playing",
              "Platform"
            ],
            "range": [
              "#2A9D8F",
              "#E76F51",
              "#3A86FF",
              "#F4A261",
              "#8338EC",
              "#6A994E"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "game_count",
              "as": "node_total"
            }
          ],
          "groupby": [
            "rating",
            "rating_order"
          ]
        },
        {
          "stack": "node_total",
          "sort": [
            {
              "field": "rating_order",
              "order": "ascending"
            }
          ],
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "node_mid"
        },
        {
          "calculate": "datum.rating + '  ' + format(datum.node_total, ',d')",
          "as": "node_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 13,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#3F4650"
      },
      "encoding": {
        "x": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.04,
              1.04
            ]
          },
          "axis": null
        },
        "y": {
          "field": "node_mid",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": false,
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "node_label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
