{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Diverging 100% stacked bars comparing player-critic rating agreement across the ten genres with the most complete paired rating records.",
  "width": 720,
  "height": 390,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/genre_rating_agreement_diverging.csv",
    "format": {
      "type": "csv",
      "parse": {
        "sort_order": "number",
        "count": "number",
        "percentage": "number",
        "x_start": "number",
        "x_end": "number",
        "x_mid": "number",
        "sample_size": "number",
        "median_gap": "number",
        "mean_gap": "number",
        "net_critic_advantage": "number"
      }
    }
  },
  "title": {
    "text": "Which Video Game Genres Divide Players and Critics?",
    "subtitle": [
      "Share of main games with both ratings: users higher by >10 points, within ±10 points, or critics higher by >10 points.",
      "Top 10 genres by complete paired-rating records; multi-genre games contribute once to each applicable genre."
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#555",
    "subtitlePadding": 6
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 25,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "genre",
          "type": "nominal",
          "sort": {"field": "sort_order", "order": "ascending"},
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelLimit": 190,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {"domain": [-60, 60]},
          "axis": {
            "title": "Share of games (%)",
            "values": [-60, -40, -20, 0, 20, 40, 60],
            "labelExpr": "abs(datum.value) + '%'",
            "grid": true,
            "gridColor": "#eeeeee",
            "titlePadding": 12
          }
        },
        "x2": {"field": "x_end"},
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": ["Users higher", "Broad agreement", "Critics higher"],
            "range": ["#4E9A9A", "#D6D6D6", "#E28E52"]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {"field": "genre", "type": "nominal", "title": "Genre"},
          {"field": "category", "type": "nominal", "title": "Rating comparison"},
          {"field": "percentage", "type": "quantitative", "title": "Share of games (%)", "format": ".1f"},
          {"field": "count", "type": "quantitative", "title": "Games", "format": ",.0f"},
          {"field": "sample_size", "type": "quantitative", "title": "Games with both ratings", "format": ",.0f"},
          {"field": "median_gap", "type": "quantitative", "title": "Median critic − user gap", "format": "+.1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative",
          "scale": {"domain": [-60, 60]}
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.percentage >= 9"},
        {"calculate": "format(datum.percentage, '.0f') + '%'", "as": "percentage_label"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "genre",
          "type": "nominal",
          "sort": {"field": "sort_order", "order": "ascending"}
        },
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {"domain": [-60, 60]}
        },
        "text": {
          "field": "percentage_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.category === 'Broad agreement'",
            "value": "#333333"
          },
          "value": "white"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {"labelFontSize": 11}
  }
}
