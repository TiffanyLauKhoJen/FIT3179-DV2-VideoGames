{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Treemap showing the top 15 video game platforms by recorded sales.",

  "width": 700,
  "height": 470,

  "title": {
    "text": "Which Platforms Account for the Most Recorded Video Game Sales?",
    "subtitle": "Top 15 platforms by reported total sales in the dataset"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/platform_sales_treemap_top15.csv"
  },

  "transform": [
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    },
    {
      "calculate": "format(datum.share_of_top15_percent, '.1f') + '%'",
      "as": "share_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },

        "x2": {
          "field": "x1"
        },

        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "reverse": true
          },
          "axis": null
        },

        "y2": {
          "field": "y1"
        },

        "color": {
          "field": "platform",
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": "tableau20"
          }
        },

        "tooltip": [
          {
            "field": "platform_full",
            "type": "nominal",
            "title": "Platform"
          },
          {
            "field": "recorded_sales_millions",
            "type": "quantitative",
            "title": "Recorded Sales (Million Units)",
            "format": ".2f"
          },
          {
            "field": "share_of_top15_percent",
            "type": "quantitative",
            "title": "Share of Top 15 (%)",
            "format": ".1f"
          },
          {
            "field": "sales_coverage_percent",
            "type": "quantitative",
            "title": "Sales Data Coverage (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "baseline": "middle",
        "dy": -8
      },

      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },

        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "platform"
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "baseline": "middle",
        "dy": 10
      },

      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100]
          },
          "axis": null
        },

        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 100],
            "reverse": true
          },
          "axis": null
        },

        "text": {
          "field": "share_label"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}