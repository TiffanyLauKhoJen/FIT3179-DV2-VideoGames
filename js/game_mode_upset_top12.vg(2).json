{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "UpSet plot showing overall game-mode set sizes and the 12 most common exact combinations among IGDB main games released from 1980 to 2024 with at least one non-single-player mode.",
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_upset_top12.csv",
    "format": {
      "type": "csv",
      "parse": {
        "combination_order": "number",
        "intersection_count": "number",
        "mode_order": "number",
        "included": "number",
        "mode_total": "number"
      }
    }
  },
  "title": {
    "text": "How Are Multiplayer-Capable Games Commonly Structured?",
    "subtitle": [
      "Top 12 exact mode combinations among IGDB-recorded main games released from 1980 to 2024.",
      "Single-player-only games are excluded; horizontal bars show totals for each displayed mode."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "subtitlePadding": 6
  },
  "spacing": 4,
  "vconcat": [
    {
      "spacing": 10,
      "hconcat": [
        {
          "width": 135,
          "height": 245,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "mode_total",
                  "as": "mode_total"
                }
              ],
              "groupby": [
                "mode",
                "mode_order"
              ]
            }
          ],
          "mark": {
            "type": "point",
            "opacity": 0
          },
          "encoding": {
            "x": {
              "field": "mode_total",
              "type": "quantitative",
              "axis": null
            },
            "y": {
              "field": "mode",
              "type": "ordinal",
              "sort": {
                "field": "mode_order",
                "order": "ascending"
              },
              "axis": {
                "title": null,
                "labelLimit": 245,
                "labelPadding": 8,
                "labelColor": "transparent",
                "ticks": false,
                "domain": false
              }
            }
          }
        },
        {
          "width": 590,
          "height": 245,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "intersection_count",
                  "as": "intersection_count"
                }
              ],
              "groupby": [
                "combination_id",
                "combination_label",
                "combination_order"
              ]
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "bar",
                "color": "#4E79A7",
                "cornerRadiusTopLeft": 2,
                "cornerRadiusTopRight": 2
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "intersection_count",
                  "type": "quantitative",
                  "title": "Number of Games in Exact Combination",
                  "axis": {
                    "format": ",d",
                    "gridColor": "#E8E8E8",
                    "tickCount": 5,
                    "domain": false
                  }
                },
                "tooltip": [
                  {
                    "field": "combination_id",
                    "type": "nominal",
                    "title": "Combination"
                  },
                  {
                    "field": "combination_label",
                    "type": "nominal",
                    "title": "Exact modes"
                  },
                  {
                    "field": "intersection_count",
                    "type": "quantitative",
                    "title": "Games",
                    "format": ",d"
                  }
                ]
              }
            },
            {
              "mark": {
                "type": "text",
                "dy": -7,
                "fontSize": 11,
                "fontWeight": "bold",
                "color": "#333333"
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "intersection_count",
                  "type": "quantitative"
                },
                "text": {
                  "field": "intersection_count",
                  "type": "quantitative",
                  "format": ",d"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "spacing": 10,
      "hconcat": [
        {
          "width": 135,
          "height": 185,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "mode_total",
                  "as": "mode_total"
                }
              ],
              "groupby": [
                "mode",
                "mode_order"
              ]
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#8D99AE",
            "cornerRadiusTopLeft": 2,
            "cornerRadiusBottomLeft": 2
          },
          "encoding": {
            "x": {
              "field": "mode_total",
              "type": "quantitative",
              "title": "Games with Mode",
              "scale": {
                "reverse": true,
                "zero": true
              },
              "axis": {
                "format": "~s",
                "grid": false,
                "domain": false,
                "tickCount": 3
              }
            },
            "y": {
              "field": "mode",
              "type": "ordinal",
              "sort": {
                "field": "mode_order",
                "order": "ascending"
              },
              "axis": {
                "title": null,
                "labelLimit": 245,
                "labelPadding": 8,
                "ticks": false,
                "domain": false
              }
            },
            "tooltip": [
              {
                "field": "mode",
                "type": "nominal",
                "title": "Game mode"
              },
              {
                "field": "mode_total",
                "type": "quantitative",
                "title": "Games containing mode",
                "format": ",d"
              }
            ]
          }
        },
        {
          "width": 590,
          "height": 185,
          "layer": [
            {
              "transform": [
                {
                  "filter": "datum.mode === datum.connector_start"
                }
              ],
              "mark": {
                "type": "rule",
                "stroke": "#333333",
                "strokeWidth": 2.3
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "connector_start",
                  "type": "ordinal",
                  "sort": {
                    "field": "mode_order",
                    "order": "ascending"
                  },
                  "axis": null
                },
                "y2": {
                  "field": "connector_end"
                }
              }
            },
            {
              "mark": {
                "type": "point",
                "filled": true,
                "strokeWidth": 0
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": {
                    "title": "Exact Mode Combination",
                    "labelAngle": 0,
                    "labelPadding": 8,
                    "ticks": false,
                    "domain": false
                  }
                },
                "y": {
                  "field": "mode",
                  "type": "ordinal",
                  "sort": {
                    "field": "mode_order",
                    "order": "ascending"
                  },
                  "axis": null
                },
                "size": {
                  "condition": {
                    "test": "datum.included === 1",
                    "value": 150
                  },
                  "value": 65
                },
                "color": {
                  "condition": {
                    "test": "datum.included === 1",
                    "value": "#333333"
                  },
                  "value": "#D9D9D9"
                },
                "tooltip": [
                  {
                    "field": "combination_id",
                    "type": "nominal",
                    "title": "Combination"
                  },
                  {
                    "field": "combination_label",
                    "type": "nominal",
                    "title": "Exact modes"
                  },
                  {
                    "field": "intersection_count",
                    "type": "quantitative",
                    "title": "Games",
                    "format": ",d"
                  },
                  {
                    "field": "mode",
                    "type": "nominal",
                    "title": "Mode row"
                  }
                ]
              }
            }
          ]
        }
      ],
      "resolve": {
        "scale": {
          "y": "shared"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 12
    },
    "concat": {
      "spacing": 10
    }
  }
}
