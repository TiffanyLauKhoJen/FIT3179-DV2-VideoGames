{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bump chart showing how the relative ranking of the seven most common game themes changed across five-year gaming eras from 1980 to 2024.",
  "width": 760,
  "height": 430,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/theme_bump_top7_eras.csv",
    "format": {
      "type": "csv",
      "parse": {
        "era_order": "number",
        "era_start": "number",
        "era_end": "number",
        "rank": "number",
        "distinct_game_count": "number",
        "themed_games_in_era": "number",
        "share_of_themed_games_pct": "number",
        "overall_theme_rank": "number",
        "overall_distinct_game_count_1980_2024": "number"
      }
    }
  },
  "title": {
    "text": "How Has the Relative Prominence of Major Game Themes Shifted Across Gaming Eras?",
    "subtitle": [
      "Top 7 themes by distinct game count across 1980–2024, ranked within each five-year era.",
      "Games may have multiple themes; each game is counted at most once per theme."
    ],
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "monotone",
        "opacity": 0.78
      },
      "encoding": {
        "x": {
          "field": "era",
          "type": "ordinal",
          "sort": {
            "field": "era_order",
            "order": "ascending"
          },
          "title": "Gaming Era",
          "axis": {
            "labelAngle": 0,
            "labelPadding": 8,
            "grid": false
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Theme Rank by Number of Games",
          "scale": {
            "domain": [
              1,
              7
            ],
            "reverse": true
          },
          "axis": {
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "tickMinStep": 1,
            "grid": true
          }
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "title": "Theme",
          "sort": {
            "field": "overall_theme_rank",
            "op": "min",
            "order": "ascending"
          },
          "scale": {
            "domain": [
              "Action",
              "Fantasy",
              "Science fiction",
              "Horror",
              "Comedy",
              "Erotic",
              "Mystery"
            ],
            "scheme": "tableau10"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 4,
            "labelLimit": 150
          }
        },
        "detail": {
          "field": "theme"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 120,
        "stroke": "white",
        "strokeWidth": 1.2,
        "opacity": 0.95
      },
      "encoding": {
        "x": {
          "field": "era",
          "type": "ordinal",
          "sort": {
            "field": "era_order",
            "order": "ascending"
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              7
            ],
            "reverse": true
          }
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Action",
              "Fantasy",
              "Science fiction",
              "Horror",
              "Comedy",
              "Erotic",
              "Mystery"
            ],
            "scheme": "tableau10"
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "theme",
            "type": "nominal",
            "title": "Theme"
          },
          {
            "field": "era",
            "type": "ordinal",
            "title": "Gaming Era"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Theme Rank",
            "format": "d"
          },
          {
            "field": "distinct_game_count",
            "type": "quantitative",
            "title": "Distinct Games",
            "format": ",d"
          },
          {
            "field": "share_of_themed_games_pct",
            "type": "quantitative",
            "title": "Share of Themed Games",
            "format": ".1f"
          },
          {
            "field": "themed_games_in_era",
            "type": "quantitative",
            "title": "Themed Games in Era",
            "format": ",d"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}