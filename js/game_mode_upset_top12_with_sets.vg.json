{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "UpSet plot with overall set sizes and the 12 most common exact game-mode combinations among IGDB main games released from 1980 to 2024 with at least one non-single-player mode.",
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_upset_top12_with_sets.csv",
    "format": {
      "type": "csv",
      "parse": {
        "combination_order": "number",
        "intersection_count": "number",
        "mode_order": "number",
        "included": "number",
        "mode_total": "number"
      }
    }
  },
  "title": {
    "text": "How Are Multiplayer-Capable Games Commonly Structured?",
    "subtitle": [
      "Top 12 exact mode combinations among IGDB-recorded main games released from 1980 to 2024.",
      "Single-player-only games are excluded; horizontal bars show totals for each displayed mode."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "subtitleColor": "#555555",
    "subtitlePadding": 6
  },
  "spacing": 4,
  "vconcat": [
    {
      "spacing": 12,
      "hconcat": [
        {
          "width": 110,
          "height": 240,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "mode_total",
                  "as": "mode_total"
                }
              ],
              "groupby": [
                "mode",
                "mode_order"
              ]
            }
          ],
          "mark": {
            "type": "point",
            "opacity": 0
          },
          "encoding": {
            "x": {
              "field": "mode_total",
              "type": "quantitative",
              "axis": null
            },
            "y": {
              "field": "mode",
              "type": "ordinal",
              "sort": [
                "Single player",
                "Multiplayer",
                "Co-operative",
                "Split screen",
                "Massively Multiplayer Online (MMO)"
              ],
              "axis": {
                "orient": "right",
                "title": null,
                "labelExpr": "datum.label === 'Massively Multiplayer Online (MMO)' ? 'MMO' : datum.label",
                "labelColor": "transparent",
                "labelPadding": 8,
                "ticks": false,
                "domain": false
              }
            }
          }
        },
        {
          "width": 560,
          "height": 240,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "intersection_count",
                  "as": "intersection_count"
                }
              ],
              "groupby": [
                "combination_id",
                "combination_label",
                "combination_order"
              ]
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "bar",
                "color": "#4E79A7",
                "cornerRadiusTopLeft": 2,
                "cornerRadiusTopRight": 2
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "intersection_count",
                  "type": "quantitative",
                  "scale": {
                    "zero": true
                  },
                  "axis": {
                    "orient": "left",
                    "title": null,
                    "labels": true,
                    "ticks": true,
                    "format": "~s",
                    "labelPadding": 5,
                    "minExtent": 35,
                    "maxExtent": 35,
                    "domain": false,
                    "grid": true,
                    "gridColor": "#E8E8E8",
                    "tickCount": 5
                  }
                },
                "tooltip": [
                  {
                    "field": "combination_id",
                    "type": "nominal",
                    "title": "Combination"
                  },
                  {
                    "field": "combination_label",
                    "type": "nominal",
                    "title": "Exact modes"
                  },
                  {
                    "field": "intersection_count",
                    "type": "quantitative",
                    "title": "Games",
                    "format": ",d"
                  }
                ]
              }
            },
            {
              "mark": {
                "type": "text",
                "dy": -7,
                "fontSize": 11,
                "fontWeight": "bold",
                "color": "#333333"
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "intersection_count",
                  "type": "quantitative"
                },
                "text": {
                  "field": "intersection_count",
                  "type": "quantitative",
                  "format": ",d"
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "angle": -90,
                "fontSize": 13,
                "color": "#000000"
              },
              "encoding": {
                "x": {
                  "value": -40
                },
                "y": {
                  "value": 120
                },
                "text": {
                  "value": "Intersection Size"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "spacing": 57,
      "hconcat": [
        {
          "width": 110,
          "height": 175,
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "mode_total",
                  "as": "mode_total"
                }
              ],
              "groupby": [
                "mode",
                "mode_order"
              ]
            }
          ],
          "mark": {
            "type": "bar",
            "color": "#8D99AE",
            "cornerRadiusTopLeft": 2,
            "cornerRadiusBottomLeft": 2
          },
          "encoding": {
            "x": {
              "field": "mode_total",
              "type": "quantitative",
              "title": "Set Size",
              "scale": {
                "reverse": true,
                "zero": true
              },
              "axis": {
                "format": "~s",
                "grid": false,
                "domain": false,
                "tickCount": 3
              }
            },
            "y": {
              "field": "mode_order",
              "type": "ordinal",
              "sort": [
                1,
                2,
                3,
                4,
                5
              ],
              "axis": {
                "orient": "right",
                "title": null,
                "labelExpr": "datum.value === 1 ? 'Single player' : datum.value === 2 ? 'Multiplayer' : datum.value === 3 ? 'Co-operative' : datum.value === 4 ? 'Split screen' : 'MMO'",
                "labelPadding": 8,
                "ticks": false,
                "domain": false
              }
            },
            "tooltip": [
              {
                "field": "mode",
                "type": "nominal",
                "title": "Game mode"
              },
              {
                "field": "mode_total",
                "type": "quantitative",
                "title": "Games containing mode",
                "format": ",d"
              }
            ]
          }
        },
        {
          "width": 560,
          "height": 175,
          "layer": [
            {
              "transform": [
                {
                  "filter": "datum.included === 1"
                },
                {
                  "aggregate": [
                    {
                      "op": "min",
                      "field": "mode_order",
                      "as": "connector_start_order"
                    },
                    {
                      "op": "max",
                      "field": "mode_order",
                      "as": "connector_end_order"
                    }
                  ],
                  "groupby": [
                    "combination_id",
                    "combination_order"
                  ]
                }
              ],
              "mark": {
                "type": "rule",
                "stroke": "#333333",
                "strokeWidth": 2.3
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": null
                },
                "y": {
                  "field": "connector_start_order",
                  "type": "ordinal",
                  "sort": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ],
                  "axis": null
                },
                "y2": {
                  "field": "connector_end_order"
                }
              }
            },
            {
              "mark": {
                "type": "point",
                "filled": true,
                "strokeWidth": 0
              },
              "encoding": {
                "x": {
                  "field": "combination_id",
                  "type": "ordinal",
                  "sort": {
                    "field": "combination_order",
                    "order": "ascending"
                  },
                  "scale": {
                    "paddingInner": 0.3,
                    "paddingOuter": 0.15
                  },
                  "axis": {
                    "title": "Exact Mode Combination",
                    "labelAngle": 0,
                    "labelPadding": 8,
                    "ticks": false,
                    "domain": false
                  }
                },
                "y": {
                  "field": "mode_order",
                  "type": "ordinal",
                  "sort": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ],
                  "axis": null
                },
                "size": {
                  "condition": {
                    "test": "datum.included === 1",
                    "value": 150
                  },
                  "value": 65
                },
                "color": {
                  "condition": {
                    "test": "datum.included === 1",
                    "value": "#333333"
                  },
                  "value": "#D9D9D9"
                },
                "tooltip": [
                  {
                    "field": "combination_id",
                    "type": "nominal",
                    "title": "Combination"
                  },
                  {
                    "field": "combination_label",
                    "type": "nominal",
                    "title": "Exact modes"
                  },
                  {
                    "field": "intersection_count",
                    "type": "quantitative",
                    "title": "Games",
                    "format": ",d"
                  },
                  {
                    "field": "mode",
                    "type": "nominal",
                    "title": "Mode row"
                  }
                ]
              }
            }
          ]
        }
      ],
      "resolve": {
        "scale": {
          "y": "shared"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10
    },
    "concat": {
      "spacing": 12
    }
  }
}
