{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How do game development and publishing listings compare across Europe?",
    "subtitle": "Europe and nearby markets · GameCompanies listings · Circle area shows count"
  },
  "width": 800,
  "height": 540,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_50m_admin_0_countries.json?v=2",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EDF0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.longitude >= -12 && datum.longitude <= 46 && datum.latitude >= 34 && datum.latitude <= 72"
        },
        {
          "fold": [
            "developed_games",
            "published_games"
          ],
          "as": [
            "activity_key",
            "game_count"
          ]
        },
        {
          "calculate": "datum.activity_key === 'developed_games' ? 'Development' : 'Publishing'",
          "as": "activity"
        },
        {
          "filter": "isValid(datum.game_count) && datum.game_count > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "game_count",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "game_count",
          "type": "quantitative",
          "title": "Games listed",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              4000
            ],
            "range": [
              16,
              1200
            ]
          },
          "legend": {
            "orient": "right",
            "values": [
              50,
              500,
              2000,
              4000
            ],
            "format": ",.0f",
            "symbolFillColor": "#D8E2E7",
            "symbolStrokeColor": "#415867"
          }
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": "Activity",
          "scale": {
            "domain": [
              "Development",
              "Publishing"
            ],
            "range": [
              "#0072B2",
              "#E69F00"
            ]
          },
          "legend": {
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "activity",
            "type": "nominal",
            "title": "Circle"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "This circle's listings",
            "format": ",.0f"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
