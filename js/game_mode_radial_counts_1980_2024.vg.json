{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Concentric radial bars showing distinct game counts per mode in 27,416 IGDB main games released in 1980–2024 with at least one retained shared-play mode. Battle Royale is removed before selecting the subset. Single-player-only games are excluded. Each ring maps 0–25,000 games to the same 270-degree sweep. Modes overlap. Reference: https://vega.github.io/vega-lite/docs/arc.html",
  "title": {
    "text": "Which modes do multiplayer-capable games offer?",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "subtitleColor": "#526274",
    "offset": 14
  },
  "width": 434,
  "height": 445,
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_radial_counts_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['Multiplayer', 'Single player', 'Co-operative', 'Split screen', 'Massively Multiplayer Online (MMO)'], datum.Mode)",
      "as": "Mode_order"
    },
    {
      "calculate": "189.0 - datum.Mode_order * 26.1",
      "as": "Outer_radius"
    },
    {
      "calculate": "datum.Outer_radius - 18.0",
      "as": "Inner_radius"
    },
    {
      "calculate": "0",
      "as": "Start_angle"
    },
    {
      "calculate": "datum.Games / 25000 * 4.71238898038469",
      "as": "End_angle"
    },
    {
      "calculate": "4.71238898038469",
      "as": "Track_end"
    },
    {
      "calculate": "228 - datum.Outer_radius + 9.0",
      "as": "Label_y"
    },
    {
      "calculate": "datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'Massively Multiplayer Online' : datum.Mode",
      "as": "Mode_display"
    },
    {
      "calculate": "datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'Massively Multiplayer|Online  ' + format(datum.Games, ',d') : datum.Mode_display + '  ' + format(datum.Games, ',d')",
      "as": "Mode_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "fill": "#EDF0F3"
      },
      "encoding": {
        "x": {
          "value": 217.0
        },
        "y": {
          "value": 228.0
        },
        "radius": {
          "field": "Outer_radius",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "Inner_radius"
        },
        "theta": {
          "field": "Start_angle",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "Track_end"
        }
      }
    },
    {
      "mark": {
        "type": "arc",
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "value": 217.0
        },
        "y": {
          "value": 228.0
        },
        "radius": {
          "field": "Outer_radius",
