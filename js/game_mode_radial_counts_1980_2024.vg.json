          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#697786",
        "lineBreak": "|",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "value": 217.0
        },
