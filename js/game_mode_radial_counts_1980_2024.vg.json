{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Concentric radial bars showing distinct game counts per mode in 27,416 IGDB main games released in 1980–2024 with at least one retained shared-play mode. Battle Royale is removed before selecting the subset. Single-player-only games are excluded. Each ring maps 0–25,000 games to the same 270-degree sweep. Modes overlap. Reference: https://vega.github.io/vega-lite/docs/arc.html",
  "title": {
    "text": "Which modes do multiplayer-capable games offer?",
    "subtitle": [
      "IGDB main games · 1980–2024 · Games may support several modes",
      "Battle Royale excluded · Each ring uses a 0–25,000-game scale"
    ],
    "anchor": "start",
    "fontSize": 19,
    "subtitleFontSize": 12,
    "subtitleColor": "#526274",
    "offset": 14
  },
  "width": 640,
  "height": 510,
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_radial_counts_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['Multiplayer', 'Single player', 'Co-operative', 'Split screen', 'Massively Multiplayer Online (MMO)'], datum.Mode)",
      "as": "Mode_order"
    },
    {
      "calculate": "210 - datum.Mode_order * 29",
      "as": "Outer_radius"
    },
    {
      "calculate": "datum.Outer_radius - 20",
      "as": "Inner_radius"
    },
    {
      "calculate": "0",
      "as": "Start_angle"
    },
    {
      "calculate": "datum.Games / 25000 * 4.71238898038469",
      "as": "End_angle"
    },
    {
      "calculate": "4.71238898038469",
      "as": "Track_end"
    },
    {
      "calculate": "260 - datum.Outer_radius + 10",
      "as": "Label_y"
    },
    {
      "calculate": "(datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'MMO' : datum.Mode) + '  ' + format(datum.Games, ',d')",
      "as": "Mode_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "fill": "#EDF0F3"
      },
      "encoding": {
        "x": {
          "value": 320
        },
        "y": {
          "value": 260
        },
        "radius": {
          "field": "Outer_radius",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "Inner_radius"
        },
        "theta": {
          "field": "Start_angle",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "Track_end"
        }
      }
    },
