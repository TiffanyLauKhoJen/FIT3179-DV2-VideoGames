          "type": "nominal",
          "scale": {
            "domain": [
              "Multiplayer",
              "Single player",
              "Co-operative",
              "Split screen",
              "Massively Multiplayer Online (MMO)"
            ],
            "range": [
              "#D260FB",
              "#F08060",
              "#0D594F",
              "#C43C8C",
              "#880707"
            ]
          },
          "legend": null
