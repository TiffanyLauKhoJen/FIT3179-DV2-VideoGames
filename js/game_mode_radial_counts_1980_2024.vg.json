{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Concentric radial bars showing distinct game counts per mode in 27,416 IGDB main games released in 1980–2024 with at least one retained shared-play mode. Battle Royale is removed before selecting the subset. Single-player-only games are excluded. Each ring maps 0–25,000 games to the same 270-degree sweep. Modes overlap. Reference: https://vega.github.io/vega-lite/docs/arc.html",
  "title": {
    "text": "Game Modes in Multiplayer-Capable Games",
    "anchor": "start",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "subtitleColor": "#526274",
    "offset": 14
  },
  "width": 434,
  "height": 445,
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/game_mode_radial_counts_1980_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Games": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['Multiplayer', 'Single player', 'Co-operative', 'Split screen', 'Massively Multiplayer Online (MMO)'], datum.Mode)",
      "as": "Mode_order"
    },
    {
      "calculate": "189.0 - datum.Mode_order * 26.1",
      "as": "Outer_radius"
    },
    {
      "calculate": "datum.Outer_radius - 13",
      "as": "Inner_radius"
    },
    {
      "calculate": "0",
      "as": "Start_angle"
    },
    {
      "calculate": "datum.Games / 25000 * 4.71238898038469",
      "as": "End_angle"
    },
    {
      "calculate": "228 - datum.Outer_radius + 6.5",
      "as": "Label_y"
    },
    {
      "calculate": "datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'Massively Multiplayer Online' : datum.Mode",
      "as": "Mode_display"
    },
    {
      "calculate": "datum.Mode === 'Massively Multiplayer Online (MMO)' ? 'Massively Multiplayer|Online  ' + format(datum.Games, ',d') : datum.Mode_display + '  ' + format(datum.Games, ',d')",
      "as": "Mode_label"
    },
    {
      "calculate": "datum.Mode === 'Multiplayer' ? '#125D73' : datum.Mode === 'Single player' ? '#946D00' : '#000000'",
      "as": "Label_color"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "cornerRadius": 2,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "value": 217.0
        },
        "y": {
          "value": 228.0
        },
        "radius": {
          "field": "Outer_radius",
          "type": "quantitative",
          "scale": null
        },
        "radius2": {
          "field": "Inner_radius"
        },
        "theta": {
          "field": "Start_angle",
          "type": "quantitative",
          "scale": null
        },
        "theta2": {
          "field": "End_angle"
        },
        "color": {
          "field": "Mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Multiplayer",
              "Single player",
              "Co-operative",
              "Split screen",
              "Massively Multiplayer Online (MMO)"
            ],
            "range": [
              "#125D73",
              "#B88700",
              "#A6595E",
              "#966699",
              "#B19A78"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Mode_display",
            "type": "nominal",
            "title": "Game mode"
          },
          {
            "field": "Games",
            "type": "quantitative",
            "title": "Games offering this mode",
            "format": ",d"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "lineBreak": "|",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "value": 206.2
        },
        "y": {
          "field": "Label_y",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "Mode_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "Mode_display",
            "type": "nominal",
            "title": "Game mode"
          },
          {
            "field": "Games",
            "type": "quantitative",
            "title": "Games offering this mode",
            "format": ",d"
          }
        ],
        "color": {
          "field": "Label_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "27,416"
          }
        ]
      },
      "transform": [],
      "mark": {
        "type": "text",
        "fontSize": 21,
        "fontWeight": "bold",
        "color": "#304455"
      },
      "encoding": {
        "x": {
          "value": 217.0
        },
        "y": {
          "value": 220.8
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
