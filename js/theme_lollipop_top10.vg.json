{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart showing the ten most frequently tagged themes in the cleaned IGDB-derived game dataset.",
  "width": 600,
  "height": 360,

  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/theme_lollipop_top10.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "distinct_game_count": "number",
        "share_of_themed_games_pct": "number"
      }
    }
  },

  "title": {
    "text": "Which Themes Appear Most Frequently Across the Game Collection?",
    "subtitle": "Top 10 themes by distinct game count; games may have multiple themes"
  },

  "encoding": {
    "y": {
      "field": "theme",
      "type": "nominal",
      "sort": {
        "field": "distinct_game_count",
        "op": "sum",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelLimit": 150
      }
    },

    "x": {
      "field": "distinct_game_count",
      "type": "quantitative",
      "title": "Number of Distinct Games",
      "axis": {
        "format": ",d"
      },
      "scale": {
        "zero": true
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120
      },
      "encoding": {
        "tooltip": [
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "theme",
            "type": "nominal",
            "title": "Theme"
          },
          {
            "field": "distinct_game_count",
            "type": "quantitative",
            "title": "Distinct Games",
            "format": ",d"
          },
          {
            "field": "share_of_themed_games_pct",
            "type": "quantitative",
            "title": "Share of Themed Games",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8
      },
      "encoding": {
        "text": {
          "field": "distinct_game_count",
          "type": "quantitative",
          "format": ",d"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "axisY": {
      "ticks": false,
      "domain": false
    },

    "axisX": {
      "grid": true
    }
  }
}