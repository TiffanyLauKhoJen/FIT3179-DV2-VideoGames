{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal lollipop chart of games ranked 1 to 15 in videogame.csv by recorded global sales.",
  "width": 885,
  "height": 320,
  "background": "white",
  "title": {
    "text": "Which Games Have the Highest Recorded Sales?",
    "anchor": "start",
    "fontSize": 17,
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/top15_games_global_sales_lollipop.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "global_sales_millions": "number",
        "year": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "title",
      "type": "nominal",
      "sort": {
        "field": "rank",
        "order": "ascending"
      },
      "title": null,
      "axis": {
        "labelLimit": 260,
        "labelFontSize": 11,
        "labelColor": {
          "condition": [
            {
              "test": "datum.value === 'Tetris'",
              "value": "#54541C"
            },
            {
              "test": "datum.value === 'Mario Kart DS'",
              "value": "#A9048E"
            }
          ],
          "value": "#000000"
        },
        "labelFontWeight": {
          "condition": {
            "test": "datum.value === 'Tetris' || datum.value === 'Mario Kart DS'",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    },
    "x": {
      "field": "global_sales_millions",
      "type": "quantitative",
      "title": "Recorded Global Sales (Millions)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": ",.0f",
        "grid": false,
        "domain": false,
        "tickMinStep": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "datum": 0
        },
        "color": {
          "field": "highlight_color",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90
      },
      "encoding": {
        "tooltip": [
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": "d"
          },
          {
            "field": "title",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "global_sales_millions",
            "type": "quantitative",
            "title": "Global Sales (Millions)",
            "format": ".2f"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Release Year",
            "format": "d"
          },
          {
            "field": "genre",
            "type": "nominal",
            "title": "Genre"
          }
        ],
        "color": {
          "field": "highlight_color",
          "type": "nominal",
          "scale": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "color": "#333333"
      },
      "encoding": {
        "text": {
          "field": "global_sales_millions",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "title": "Tetris",
            "x": 44,
            "note": "Bundled with Game Boy in major markets,|its sales also benefited from console purchases."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "lineBreak": "|",
        "fontSize": 11,
        "lineHeight": 14,
        "dy": -7,
        "color": "#54541C"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "order": "ascending"
          }
        },
        "text": {
          "field": "note"
        },
        "tooltip": null
      }
    },
    {
      "data": {
        "values": [
          {
            "title": "Mario Kart DS",
            "x": 44,
            "note": "Online racing attracted early interest:|45% of first-week United States buyers|tried the feature."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "lineBreak": "|",
        "fontSize": 11,
        "lineHeight": 14,
        "dy": -14,
        "color": "#A9048E"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "order": "ascending"
          }
        },
        "text": {
          "field": "note"
        },
        "tooltip": null
      }
    },
    {
      "data": {
        "values": [
          {
            "title": "Tetris",
            "x": 34.67,
            "x2": 43.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#54541C"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "order": "ascending"
          }
        },
        "tooltip": null
      }
    },
    {
      "data": {
        "values": [
          {
            "title": "Mario Kart DS",
            "x": 27.85,
            "x2": 43.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#A9048E"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "rank",
            "order": "ascending"
          }
        },
        "tooltip": null
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  },
  "transform": [
    {
      "calculate": "datum.title === 'Pokemon Red/Pokemon Blue' ? 'Pokémon Red/Blue' : datum.title === 'Pokemon Gold/Pokemon Silver' ? 'Pokémon Gold/Silver' : datum.title",
      "as": "title"
    },
    {
      "calculate": "datum.title === 'Tetris' ? '#54541C' : datum.title === 'Mario Kart DS' ? '#A9048E' : '#A3ACB8'",
      "as": "highlight_color"
    }
  ]
}
