{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hierarchical treemap of recorded video-game sales: platform family to individual platform.",
  "width": 700,
  "height": 470,
  "title": {
    "text": "How Are Recorded Video Game Sales Distributed Across Platform Families?",
    "subtitle": [
      "Outer regions group related platform families; inner rectangles represent individual platforms.",
      "Area represents recorded total sales; Top 15 platforms are shown individually and the rest are grouped as Other."
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/platform_family_treemap_top15_plus_other.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "recorded_sales_millions": "number",
        "share_of_all_recorded_sales_percent": "number",
        "family_recorded_sales_millions": "number",
        "family_share_of_all_recorded_sales_percent": "number",
        "sales_records": "number",
        "total_records": "number",
        "sales_coverage_percent": "number",
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number",
        "parent_x0": "number",
        "parent_x1": "number",
        "parent_y0": "number",
        "parent_y1": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    },
    {
      "calculate": "(datum.x1-datum.x0)*(datum.y1-datum.y0)",
      "as": "cell_area"
    },
    {
      "calculate": "format(datum.share_of_all_recorded_sales_percent, '.1f') + '%'",
      "as": "platform_share_label"
    },
    {
      "calculate": "format(datum.recorded_sales_millions, '.0f') + 'M units'",
      "as": "sales_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "family",
          "type": "nominal",
          "title": "Platform family",
          "scale": {
            "domain": [
              "PlayStation",
              "Xbox",
              "Nintendo",
              "PC",
              "Other Platforms"
            ],
            "range": [
              "#7EA6E0",
              "#82B366",
              "#D79B00",
              "#9673A6",
              "#B3B3B3"
            ]
          }
        },
        "tooltip": [
          {
            "field": "family",
            "type": "nominal",
            "title": "Platform Family"
          },
          {
            "field": "platform_full",
            "type": "nominal",
            "title": "Platform"
          },
          {
            "field": "recorded_sales_millions",
            "type": "quantitative",
            "title": "Recorded Sales (Million Units)",
            "format": ".2f"
          },
          {
            "field": "share_of_all_recorded_sales_percent",
            "type": "quantitative",
            "title": "Share of All Recorded Sales (%)",
            "format": ".1f"
          },
          {
            "field": "family_share_of_all_recorded_sales_percent",
            "type": "quantitative",
            "title": "Family Share of Recorded Sales (%)",
            "format": ".1f"
          },
          {
            "field": "sales_coverage_percent",
            "type": "quantitative",
            "title": "Sales Data Coverage (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "parent_x0",
              "as": "px0"
            },
            {
              "op": "max",
              "field": "parent_x1",
              "as": "px1"
            },
            {
              "op": "min",
              "field": "parent_y0",
              "as": "py0"
            },
            {
              "op": "max",
              "field": "parent_y1",
              "as": "py1"
            }
          ],
          "groupby": [
            "family"
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "fillOpacity": 0,
        "stroke": "#333333",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "px0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "px1"
        },
        "y": {
          "field": "py0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "py1"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center",
        "dy": -12
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "platform"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center",
        "dy": 4
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "platform_share_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.cell_area >= 300"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "baseline": "middle",
        "align": "center",
        "dy": 20
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "sales_label"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "parent_x0",
              "as": "px0"
            },
            {
              "op": "max",
              "field": "parent_x1",
              "as": "px1"
            },
            {
              "op": "min",
              "field": "parent_y0",
              "as": "py0"
            },
            {
              "op": "max",
              "field": "parent_y1",
              "as": "py1"
            },
            {
              "op": "max",
              "field": "family_share_of_all_recorded_sales_percent",
              "as": "family_share"
            }
          ],
          "groupby": [
            "family"
          ]
        },
        {
          "calculate": "(datum.px0 + datum.px1) / 2",
          "as": "family_x"
        },
        {
          "calculate": "datum.py0 + 1.3",
          "as": "family_y"
        },
        {
          "calculate": "datum.family + '  ' + format(datum.family_share, '.1f') + '%'",
          "as": "family_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "top",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "family_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "family_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "family_label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "title": null
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12,
      "anchor": "middle"
    }
  }
}