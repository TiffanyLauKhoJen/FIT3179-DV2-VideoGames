{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where is listed game activity concentrated across Europe?",
    "subtitle": "GameCompanies · Circle area: combined listings · Colour: publishing share"
  },
  "width": 800,
  "height": 540,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_50m_admin_0_countries.json?v=2",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EDF0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.longitude >= -12 && datum.longitude <= 46 && datum.latitude >= 34 && datum.latitude <= 72"
        },
        {
          "calculate": "datum.developed_games + datum.published_games",
          "as": "total_listings"
        },
        {
          "filter": "isValid(datum.total_listings) && datum.total_listings > 0"
        },
        {
          "calculate": "datum.published_games / datum.total_listings",
          "as": "publishing_share"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.88,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total_listings",
          "type": "quantitative",
          "title": "Combined listings",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              6625
            ],
            "range": [
              18,
              1900
            ]
          },
          "legend": {
            "orient": "right",
            "values": [
              100,
              500,
              2000,
              6500
            ],
            "format": ",.0f",
            "symbolFillColor": "#D8E2E7",
            "symbolStrokeColor": "#415867"
          }
        },
        "color": {
          "field": "publishing_share",
          "type": "quantitative",
          "title": "Publishing share",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              0.5,
              1
            ],
            "range": [
              "#0072B2",
              "#E9ECEF",
              "#C77800"
            ]
          },
          "legend": {
            "orient": "right",
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          },
          {
            "field": "total_listings",
            "type": "quantitative",
            "title": "Combined listings",
            "format": ",.0f"
          },
          {
            "field": "publishing_share",
            "type": "quantitative",
            "title": "Publishing share",
            "format": ".0%"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
