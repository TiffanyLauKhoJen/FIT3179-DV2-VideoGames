{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dumbbell chart comparing five visual player perspectives in 1984 and 2024.",
  "width": 610,
  "height": 300,
  "data": {
    "url": "data/player_perspective_dumbbell_1984_2024.csv"
  },
  "title": {
    "text": "How Have Visual Player Perspectives Changed Over 40 Years?",
    "subtitle": [
      "Share of main games with recorded player-perspective metadata, 1984 vs 2024.",
      "Auditory and Text are omitted from display; games may contain multiple perspectives."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 11,
    "subtitleColor": "#666666",
    "offset": 14
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#C9CDD3"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": {
            "field": "abs_change_pp",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelLimit": 160
          }
        },
        "x": {
          "field": "pct_1984",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              50
            ]
          },
          "axis": {
            "title": "Share of games with recorded perspective metadata (%)",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "grid": true,
            "tickCount": 6
          }
        },
        "x2": {
          "field": "pct_2024"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#6B7280",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": {
            "field": "abs_change_pp",
            "order": "descending"
          }
        },
        "x": {
          "field": "pct_1984",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "value": "1984",
            "title": "Year"
          },
          {
            "field": "pct_1984",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          },
          {
            "field": "count_1984",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "denominator_1984",
            "type": "quantitative",
            "title": "Games with perspective data",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "'1984: ' + format(datum.pct_1984, '.1f') + '%'",
          "as": "label_1984"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -13,
        "fontSize": 10,
        "color": "#4B5563"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": {
            "field": "abs_change_pp",
            "order": "descending"
          }
        },
        "x": {
          "field": "pct_1984",
          "type": "quantitative"
        },
        "text": {
          "field": "label_1984"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "color": "#0F766E",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": {
            "field": "abs_change_pp",
            "order": "descending"
          }
        },
        "x": {
          "field": "pct_2024",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Perspective"
          },
          {
            "value": "2024",
            "title": "Year"
          },
          {
            "field": "pct_2024",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          },
          {
            "field": "count_2024",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "denominator_2024",
            "type": "quantitative",
            "title": "Games with perspective data",
            "format": ","
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "'2024: ' + format(datum.pct_2024, '.1f') + '%'",
          "as": "label_2024"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 14,
        "fontSize": 10,
        "color": "#0F766E"
      },
      "encoding": {
        "y": {
          "field": "perspective",
          "type": "nominal",
          "sort": {
            "field": "abs_change_pp",
            "order": "descending"
          }
        },
        "x": {
          "field": "pct_2024",
          "type": "quantitative"
        },
        "text": {
          "field": "label_2024"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#D1D5DB",
      "gridColor": "#ECEFF1"
    }
  }
}