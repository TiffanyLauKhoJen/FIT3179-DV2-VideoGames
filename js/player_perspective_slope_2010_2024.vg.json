      }
    },
    {
      "data": {
        "values": [
          {
            "note": "More indie horror and|exploration games use|first person so players|feel inside the world."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
          "value": 112
        },
        "y": {
          "value": 251.7
        },
        "text": {
          "field": "note"
        },
        "color": {
