{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual comparison of five visual player perspectives in 2010 and 2024. Source: game_dataset_cleaned(1).csv. Distinct main_game IDs, valid release dates. Each year denominator is the union of games tagged with at least one selected visual perspective (2010: 1,211; 2024: 6,376). Text/Auditory-only and missing perspective records are excluded; games with a selected visual perspective are retained even if they also have a Text/Auditory tag. Games can have multiple perspectives, so percentages need not sum to 100. The 2010 baseline maximizes the sum of absolute percentage-point differences from 2024 across the five perspectives, among baseline years 2010–2023. Endpoint comparison only. Colour values avoid exact reuse of the supplied dashboard palette; families necessarily recur.",
  "title": {
    "text": "Changes in Visual Game Perspectives, 2010–2024",
    "anchor": "start",
    "fontSize": 17,
    "offset": 16
  },
  "width": 392,
  "height": 307,
  "padding": 8,
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/player_perspective_slope_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "games_with_perspective": "number",
        "denominator_games": "number",
        "share_pct": "number",
        "change_pp": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.share_pct, '.1f') + '%'",
      "as": "percentage_label"
    },
    {
      "calculate": "datum.perspective === 'Side view' ? '#69733F' : datum.perspective === 'Bird view / Isometric' ? '#516B5D' : datum.perspective === 'Virtual Reality' ? '#526A99' : datum.perspective === 'First person' ? '#C41FD6' : '#9B633E'",
      "as": "label_color"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2010,
        2024
      ],
      "title": "Release year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12,
        "titlePadding": 8
      }
    },
    "y": {
      "field": "share_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          40
        ],
        "nice": false
      },
      "axis": {
        "title": "Share of games with this perspective (%)",
        "values": [
          0,
          10,
          20,
          30,
          40
        ],
        "labelFontSize": 12,
        "titleFontSize": 12,
        "grid": true,
        "gridColor": "#E5E7EB",
        "domain": false,
        "tickColor": "#D1D5DB",
        "titlePadding": 10
      }
    },
    "color": {
      "field": "perspective",
      "type": "nominal",
      "title": "Player Perspective",
      "scale": {
        "domain": [
          "Side view",
          "First person",
          "Bird view / Isometric",
          "Third person",
          "Virtual Reality"
        ],
        "range": [
          "#7A852F",
          "#C41FD6",
          "#507D68",
          "#9B633E",
          "#8F9FBD"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "labelFontSize": 12,
        "titleFontSize": 12,
        "labelLimit": 230,
        "symbolSize": 95,
        "offset": 18
      }
    },
    "opacity": {
      "field": "perspective",
      "type": "nominal",
      "scale": {
        "domain": [
          "Side view",
          "First person",
          "Bird view / Isometric",
          "Third person",
          "Virtual Reality"
        ],
        "range": [
          0.85,
          1,
          0.85,
          1,
          1
        ],
        "type": "ordinal"
      },
      "title": "Player Perspective",
      "sort": [
        "Side view",
        "First person",
        "Bird view / Isometric",
        "Third person",
        "Virtual Reality"
      ]
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.perspective === 'Side view'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#C0C5CC"
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "nice": false
          }
        },
        "y2": {
          "datum": 40
        },
        "color": {
          "value": "#C0C5CC"
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "perspective"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of games with visual perspective recorded (%)",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games with this perspective",
            "format": ",d"
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Games with a selected visual perspective",
            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ],
        "strokeWidth": {
          "condition": {
            "test": "datum.perspective === 'First person' || datum.perspective === 'Third person'",
            "value": 3
          },
          "value": 2
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 105,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of games with visual perspective recorded (%)",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games with this perspective",
            "format": ",d"
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Games with a selected visual perspective",
            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2010"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -11,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "percentage_label"
        },
        "color": {
          "field": "label_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        },
        {
          "calculate": "datum.perspective === 'Bird view / Isometric' ? datum.share_pct + 1.2 : datum.perspective === 'Side view' ? datum.share_pct - 0.8 : datum.perspective === 'First person' ? datum.share_pct - 0.1 : datum.share_pct",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "nice": false
          }
        },
        "text": {
          "field": "percentage_label"
        },
        "color": {
          "field": "label_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "description": "Annotation for the First person line, in the empty space below the crossing lines (pixel positions: 2010 at x 98, 2024 at x 294).",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#C41FD6",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": 140
        },
        "y": {
          "value": 202
        },
        "x2": {
          "value": 152
        },
        "y2": {
          "value": 152.8
        },
        "color": {
          "value": "#C41FD6"
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "note": "More indie horror and|exploration games adopted a|first-person view to encourage|immersive experience."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "lineBreak": "|"
      },
      "encoding": {
        "x": {
          "value": 106
        },
        "y": {
          "value": 205
        },
        "text": {
          "field": "note"
        },
        "color": {
          "value": "#3F4756"
        },
        "opacity": {
          "value": 1
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    }
  }
}