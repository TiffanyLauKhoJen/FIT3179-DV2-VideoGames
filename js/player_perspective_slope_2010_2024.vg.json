            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.perspective === 'First person' || datum.perspective === 'Third person'"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2010"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -11,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "percentage_label"
        },
        "color": {
          "field": "label_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024"
        },
        {
          "calculate": "datum.perspective === 'Bird view / Isometric' ? datum.share_pct + 1.2 : datum.perspective === 'Side view' ? datum.share_pct - 0.8 : datum.perspective === 'First person' ? datum.share_pct - 0.1 : datum.share_pct",
          "as": "label_y"
        },
        {
          "calculate": "datum.percentage_label + '  ' + datum.perspective",
          "as": "end_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 11,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "nice": false
          }
        },
        "text": {
          "field": "end_label"
        },
        "color": {
          "field": "label_color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "description": "Annotation for the First person line, in the empty space below the crossing lines (pixel positions: 2010 at x 98, 2024 at x 294).",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#E78AC3",
        "strokeWidth": 1
      },
      "encoding": {
