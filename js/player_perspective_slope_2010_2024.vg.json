{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual comparison of five visual player perspectives in 2010 and 2024. Source: game_dataset_cleaned(1).csv. Distinct main_game IDs, valid release dates. Each year denominator is the union of games tagged with at least one selected visual perspective (2010: 1,211; 2024: 6,376). Text/Auditory-only and missing perspective records are excluded; games with a selected visual perspective are retained even if they also have a Text/Auditory tag. Games can have multiple perspectives, so percentages need not sum to 100. The 2010 baseline maximizes the sum of absolute percentage-point differences from 2024 across the five perspectives, among baseline years 2010–2023. Endpoint comparison only. Colour values avoid exact reuse of the supplied dashboard palette; families necessarily recur.",
  "title": {
    "text": "How Did Game Perspectives Shift (2010–2024)?",
    "anchor": "start",
    "dx": -11,
    "fontSize": 19,
    "offset": 22
  },
  "width": 366,
  "height": 365,
  "autosize": {
    "type": "none"
  },
  "padding": {
    "left": 70,
    "right": 16,
    "top": 60,
    "bottom": 72
  },
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/player_perspective_slope_2010_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "games_with_perspective": "number",
        "denominator_games": "number",
        "share_pct": "number",
        "change_pp": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.share_pct, '.1f') + '%'",
      "as": "percentage_label"
    },
    {
      "calculate": "datum.perspective === 'First person' ? '#E78AC3' : datum.perspective === 'Third person' ? '#7A285A' : '#8A919C'",
      "as": "label_color"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2010,
        2024
      ],
      "title": "Release Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelFontWeight": "bold",
        "labelPadding": 12,
        "domain": false,
        "ticks": false,
        "titleFontSize": 12,
        "titlePadding": 8,
        "titleY": 55
      },
      "scale": {
        "range": [
          40,
          290
        ]
      }
    },
    "y": {
      "field": "share_pct",
      "type": "quantitative",
      "title": "Share of Games (%)",
      "scale": {
        "domain": [
          0,
          40
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          10,
          20,
          30,
          40
        ],
        "labelExpr": "datum.value + '%'",
        "grid": false,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titlePadding": 12
      }
    },
    "color": {
      "field": "perspective",
      "type": "nominal",
      "title": "Player Perspective",
      "scale": {
        "domain": [
          "Side view",
          "First person",
          "Bird view / Isometric",
          "Third person",
          "Virtual Reality"
        ],
        "range": [
          "#C5CAD1",
          "#E78AC3",
          "#C5CAD1",
          "#7A285A",
          "#C5CAD1"
        ]
      },
      "legend": null
    },
    "opacity": {
      "field": "perspective",
      "type": "nominal",
      "scale": {
        "domain": [
          "Side view",
          "First person",
          "Bird view / Isometric",
          "Third person",
          "Virtual Reality"
        ],
        "range": [
          0.85,
          1,
          0.85,
          1,
          1
        ],
        "type": "ordinal"
      },
      "title": "Player Perspective",
      "sort": [
        "Side view",
        "First person",
        "Bird view / Isometric",
        "Third person",
        "Virtual Reality"
      ]
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.perspective === 'Side view'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.5,
        "color": "#7A93B8"
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40
            ],
            "nice": false
          }
        },
        "y2": {
          "datum": 40
        },
        "color": {
          "value": "#7A93B8"
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "perspective"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of games with visual perspective recorded (%)",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games with this perspective",
            "format": ",d"
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Games with a selected visual perspective",
            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ],
        "strokeWidth": {
          "condition": {
            "test": "datum.perspective === 'First person' || datum.perspective === 'Third person'",
            "value": 3
          },
          "value": 2
        }
      },
      "transform": [
        {
          "filter": "!(datum.perspective === 'First person' || datum.perspective === 'Third person')"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 105,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of games with visual perspective recorded (%)",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games with this perspective",
            "format": ",d"
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Games with a selected visual perspective",
            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ]
      },
      "transform": [
        {
          "filter": "!(datum.perspective === 'First person' || datum.perspective === 'Third person')"
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "perspective"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of games with visual perspective recorded (%)",
            "format": ".1f"
          },
          {
            "field": "games_with_perspective",
            "type": "quantitative",
            "title": "Games with this perspective",
            "format": ",d"
          },
          {
            "field": "denominator_games",
            "type": "quantitative",
            "title": "Games with a selected visual perspective",
            "format": ",d"
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "2010–2024 change (percentage points)",
            "format": "+.1f"
          }
        ],
        "strokeWidth": {
          "condition": {
            "test": "datum.perspective === 'First person' || datum.perspective === 'Third person'",
            "value": 3
          },
          "value": 2
        }
      },
      "transform": [
        {
          "filter": "datum.perspective === 'First person' || datum.perspective === 'Third person'"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 105,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "perspective",
            "type": "nominal",
            "title": "Player perspective"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "share_pct",
