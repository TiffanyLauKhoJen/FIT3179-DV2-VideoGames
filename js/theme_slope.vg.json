{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart comparing the prevalence of the eight themes with the largest absolute percentage-point changes between 2000 and 2024.",
  "width": 560,
  "height": 420,
  "data": {
  "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/theme_slope_2000_2024.csv"
},
  "title": {
    "text": "How Have Video Game Themes Shifted Since 2000?",
    "subtitle": "Eight themes with the largest absolute changes in prevalence, 2000 vs 2024"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 80
        },
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2000,
            2024
          ],
          "scale": {
            "padding": 0.35
          },
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 13
          }
        },
        "y": {
          "field": "prevalence_percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              70
            ]
          },
          "axis": {
            "title": "Games with theme (%)",
            "format": ".0f",
            "grid": true
          }
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "legend": null
        },
        "detail": {
          "field": "theme"
        },
        "tooltip": [
          {
            "field": "theme",
            "type": "nominal",
            "title": "Theme"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "prevalence_percent",
            "type": "quantitative",
            "title": "Prevalence",
            "format": ".2f"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "Games",
            "format": ","
          },
          {
            "field": "change_pp",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2000,
            2024
          ]
        },
        "y": {
          "field": "prevalence_percent",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              70
            ]
          }
        },
        "text": {
          "field": "theme"
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}