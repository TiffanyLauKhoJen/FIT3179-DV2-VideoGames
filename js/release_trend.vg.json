{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart of recorded IGDB main-game releases per year, with vertical reference lines for industry events in 2015 and 2017 and a callout on 2024.",
  "width": 558,
  "height": 280,
  "title": {
    "text": "How Many Video Games Were Released Each Year (2010–2025)?",
    "anchor": "start",
    "fontSize": 19,
    "offset": 12
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/dataset_g1.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Main_game_count": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": "Release Year",
      "scale": {
        "domain": [
          2010,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "grid": false,
        "tickCount": 8,
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },
    "y": {
      "field": "Main_game_count",
      "type": "quantitative",
      "title": "Recorded Main-Game Releases",
      "scale": {
        "domain": [
          0,
          20000
        ]
      },
      "axis": {
        "grid": false,
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "x": 2015,
            "y": 0,
            "y2": 20000
          },
          {
            "x": 2017,
            "y": 0,
            "y2": 20000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6B7280",
        "strokeWidth": 1,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#0072B2",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "color": "#0072B2",
          "size": 40
        }
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Main_game_count",
            "type": "quantitative",
            "title": "Releases",
            "format": ",d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === 2024"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "color": "#0072B2",
        "strokeWidth": 1.5,
        "size": 160
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Main_game_count",
            "type": "quantitative",
            "title": "Releases",
            "format": ",d"
          }
        ]
      }
    },
    {
      "layer": [
        {
          "data": {
            "values": [
              {
                "x": 2015,
                "y": 19900,
                "text": "Unity and Unreal Engine|become free to use"
              }
            ]
          },
          "mark": {
            "baseline": "top",
            "fontSize": 11,
            "lineHeight": 14,
            "lineBreak": "|",
            "color": "#3F4756",
            "type": "text",
            "align": "right",
            "dx": -5
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "x": 2017,
                "y": 19900,
                "text": "Steam Direct replaced|Greenlight voting|with review"
              }
            ]
          },
          "mark": {
            "baseline": "top",
            "fontSize": 11,
            "lineHeight": 14,
            "lineBreak": "|",
            "color": "#3F4756",
            "type": "text",
            "align": "left",
            "dx": 5
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "text": {
              "field": "text"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "x": 2023.55,
            "y": 19250,
            "x2": 2023.85,
            "y2": 18650
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#9AA1AD",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2023.45,
            "y": 19900,
            "text": "About 25% of top new|Steam games came from|first-time developers"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "lineHeight": 14,
        "lineBreak": "|",
        "color": "#3F4756"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "text": {
      "fontSize": 11
    }
  }
}