{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Horizontal bar chart showing the top 10 game titles by summed recorded platform-level total sales in the Video Games Sales 1980-2024 dataset.",
  "width": 650,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/top10_games_recorded_sales.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "recorded_total_sales_millions": "number",
        "platforms_with_reported_sales": "number",
        "earliest_recorded_release_year": "number",
        "reported_platform_rows": "number"
      }
    }
  },
  "title": {
    "text": "Which Games Have the Highest Recorded Sales?",
    "subtitle": "Top 10 titles by summed reported sales across platform records; missing sales values are excluded.",
    "anchor": "start"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "recorded_total_sales_millions",
            "op": "sum",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 220,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "title": "Recorded Total Sales (Millions)",
          "axis": {
            "grid": true
          }
        },
        "tooltip": [
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": "d"
          },
          {
            "field": "title",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "recorded_total_sales_millions",
            "type": "quantitative",
            "title": "Recorded Sales (M)",
            "format": ".2f"
          },
          {
            "field": "platforms_with_reported_sales",
            "type": "quantitative",
            "title": "Platforms with Reported Sales",
            "format": "d"
          },
          {
            "field": "earliest_recorded_release_year",
            "type": "quantitative",
            "title": "Earliest Recorded Release",
            "format": "d"
          },
          {
            "field": "dominant_genre",
            "type": "nominal",
            "title": "Genre"
          },
          {
            "field": "dominant_publisher",
            "type": "nominal",
            "title": "Publisher"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 11
      },
      "encoding": {
        "y": {
          "field": "title",
          "type": "nominal",
          "sort": {
            "field": "recorded_total_sales_millions",
            "op": "sum",
            "order": "descending"
          }
        },
        "x": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative"
        },
        "text": {
          "field": "recorded_total_sales_millions",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12
    }
  }
}