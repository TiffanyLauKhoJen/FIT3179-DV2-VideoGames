{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are game development and publishing recorded?",
    "subtitle": "Games listed by country in GameCompanies · Circle size shows recorded game count"
  },
  "width": 900,
  "height": 500,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8EDF0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "fold": ["developed_games", "published_games"],
          "as": ["activity_key", "game_count"]
        },
        {
          "calculate": "datum.activity_key === 'developed_games' ? 'Development' : 'Publishing'",
          "as": "activity"
        },
        {
          "calculate": "datum.activity_key === 'developed_games' ? -7 : 7",
          "as": "offset_px"
        },
        {"filter": "isValid(datum.game_count) && datum.game_count > 0"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.68,
        "stroke": "#263238",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "xOffset": {
          "field": "offset_px",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "game_count",
          "type": "quantitative",
          "title": "Recorded games",
          "scale": {
            "type": "linear",
            "domain": [0, 11344],
            "range": [16, 2200]
          },
          "legend": {"orient": "right", "format": ",.0f"}
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": "Activity",
          "scale": {
            "domain": ["Development", "Publishing"],
            "range": ["#2F80ED", "#F2994A"]
          },
          "legend": {"orient": "right"}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Location"},
          {"field": "activity", "type": "nominal", "title": "Activity"},
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "Recorded games",
            "format": ",.0f"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development count",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing count",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
