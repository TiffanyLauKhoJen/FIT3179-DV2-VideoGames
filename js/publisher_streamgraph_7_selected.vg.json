{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph of annual distinct-title release activity for seven selected major publisher families in the Video Game Sales 1980-2024 collection.",
  "width": 720,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/publisher_streamgraph_7_selected.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "distinct_titles": "number",
        "share_selected_publishers_pct": "number",
        "publisher_order": "number"
      }
    }
  },
  "title": {
    "text": "How Has Game Release Activity Shifted Among Major Publishers?",
    "subtitle": "Annual distinct titles, 1980\u20132024; one title counted once using its earliest recorded release year"
  },
  "params": [
    {
      "name": "publisher_hover",
      "select": {
        "type": "point",
        "fields": [
          "publisher_family"
        ],
        "on": "pointerover",
        "clear": "pointerout",
        "toggle": false
      }
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Release Year",
      "scale": {
        "zero": false
      },
      "axis": {
        "format": "d",
        "tickCount": 10,
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "distinct_titles",
      "type": "quantitative",
      "stack": "center",
      "title": null,
      "axis": null
    },
    "color": {
      "field": "publisher_family",
      "type": "nominal",
      "title": "Publisher",
      "scale": {
        "scheme": "tableau10"
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 4,
        "labelLimit": 140
      }
    },
    "order": {
      "field": "publisher_order",
      "type": "ordinal",
      "sort": "ascending"
    },
    "opacity": {
      "condition": {
        "param": "publisher_hover",
        "value": 1,
        "empty": false
      },
      "value": 0.72
    },
    "tooltip": [
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "publisher_family",
        "type": "nominal",
        "title": "Publisher"
      },
      {
        "field": "distinct_titles",
        "type": "quantitative",
        "title": "Distinct Titles",
        "format": ",d"
      },
      {
        "field": "share_selected_publishers_pct",
        "type": "quantitative",
        "title": "Share of Selected Publishers",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12,
      "anchor": "start"
    }
  }
}