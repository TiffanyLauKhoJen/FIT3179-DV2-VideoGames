{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Treemap of the top 15 platforms plus all remaining platforms grouped as Other, sized by recorded video-game sales.",
  "width": 700,
  "height": 470,
  "title": {
    "text": "How Are Recorded Video Game Sales Distributed Across Platforms?",
    "subtitle": [
      "Rectangle size represents recorded total sales.",
      "Top 15 platforms are shown individually; all remaining platforms are grouped as Other."
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/platform_sales_treemap_top15_plus_other.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rank": "number",
        "recorded_sales_millions": "number",
        "share_of_all_recorded_sales_percent": "number",
        "sales_records": "number",
        "total_records": "number",
        "sales_coverage_percent": "number",
        "x0": "number",
        "x1": "number",
        "y0": "number",
        "y1": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "y_mid"
    },
    {
      "calculate": "(datum.x1-datum.x0)*(datum.y1-datum.y0)",
      "as": "cell_area"
    },
    {
      "calculate": "format(datum.share_of_all_recorded_sales_percent, '.1f') + '%'",
      "as": "share_label"
    },
    {
      "calculate": "format(datum.recorded_sales_millions, '.0f') + 'M units'",
      "as": "sales_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "platform",
          "type": "nominal",
          "legend": null,
          "scale": {
            "scheme": "tableau20"
          }
        },
        "tooltip": [
          {
            "field": "platform_full",
            "type": "nominal",
            "title": "Platform"
          },
          {
            "field": "recorded_sales_millions",
            "type": "quantitative",
            "title": "Recorded Sales (Million Units)",
            "format": ".2f"
          },
          {
            "field": "share_of_all_recorded_sales_percent",
            "type": "quantitative",
            "title": "Share of All Recorded Sales (%)",
            "format": ".1f"
          },
          {
            "field": "sales_records",
            "type": "quantitative",
            "title": "Records with Sales Data",
            "format": ","
          },
          {
            "field": "total_records",
            "type": "quantitative",
            "title": "Total Platform Records",
            "format": ","
          },
          {
            "field": "sales_coverage_percent",
            "type": "quantitative",
            "title": "Sales Data Coverage (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center",
        "dy": -12
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "platform"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center",
        "dy": 4
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "share_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.cell_area >= 330"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "baseline": "middle",
        "align": "center",
        "dy": 20
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "sales_label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 12,
      "anchor": "middle"
    }
  }
}