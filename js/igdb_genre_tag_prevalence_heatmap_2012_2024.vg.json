{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which game tags became more common over time?",
    "subtitle": [
      "Share of IGDB main games released each year with each tag · 2012–2024",
      "Seven genres plus the Action theme · Games may have multiple tags; rows do not sum to 100%"
    ],
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#526274",
    "offset": 15
  },
  "width": 780,
  "height": {
    "step": 45
  },
  "data": {
    "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/igdb_genre_tag_prevalence_heatmap_2012_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Tagged_games": "number",
        "Main_games": "number",
        "Prevalence_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "format(datum.Prevalence_pct, '.1f') + '%'",
      "as": "Cell_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "sort": "ascending",
      "title": "Release year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "grid": false,
        "tickSize": 0
      }
    },
    "y": {
      "field": "Tag",
      "type": "nominal",
      "sort": [
        "Sports",
        "Action",
        "Shooter",
        "Racing",
        "Role-Playing",
        "Fighting",
        "Adventure",
        "Platform"
      ],
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 10,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "Prevalence_pct",
          "type": "quantitative",
          "title": "Main games with tag (%)",
          "scale": {
            "domain": [
              0,
              45
            ],
            "range": [
              "#F1F7FD",
              "#B9D6ED",
              "#72B3D6",
              "#317DB5",
              "#0B3C75"
            ]
          },
          "legend": {
            "orient": "right",
            "gradientLength": 230,
            "values": [
              0,
              10,
              20,
              30,
              40
            ],
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Release year"
          },
          {
            "field": "Tag",
            "type": "nominal",
            "title": "Tag"
          },
          {
            "field": "Tag_kind",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "Prevalence_pct",
            "type": "quantitative",
            "title": "Main games with tag (%)",
            "format": ".1f"
          },
          {
            "field": "Tagged_games",
            "type": "quantitative",
            "title": "Tagged games",
            "format": ",d"
          },
          {
            "field": "Main_games",
            "type": "quantitative",
            "title": "All main games that year",
            "format": ",d"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "Cell_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.Prevalence_pct >= 24",
            "value": "#FFFFFF"
          },
          "value": "#20354A"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
