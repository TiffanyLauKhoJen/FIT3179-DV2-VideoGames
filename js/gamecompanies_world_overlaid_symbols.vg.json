{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Where are recorded game development and",
      "publishing listings concentrated?"
    ],
    "subtitle": [
      "GameCompanies by location · Blue: development · Orange: publishing",
      "Circle area: listings · Click the legend to filter"
    ]
  },
  "width": 760,
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "fold": [
            "developed_games",
            "published_games"
          ],
          "as": [
            "activity_key",
            "game_count"
          ]
        },
        {
          "calculate": "datum.activity_key === 'developed_games' ? 'Development' : 'Publishing'",
          "as": "activity"
        },
        {
          "filter": "isValid(datum.game_count) && datum.game_count > 0"
        }
      ],
      "params": [
        {
          "name": "activity_pick",
          "select": {
            "type": "point",
            "fields": [
              "activity"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "activity_pick",
            "value": 0.72
          },
          "value": 0.06
        },
        "order": {
          "field": "game_count",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "game_count",
          "type": "quantitative",
          "title": "GameCompanies listings",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              11344
            ],
            "range": [
              16,
              2200
            ]
          },
          "legend": {
            "orient": "right",
            "values": [
              50,
              500,
              2000,
              10000
            ],
            "format": ",.0f",
            "symbolFillColor": "#D8E2E7",
            "symbolStrokeColor": "#415867"
          }
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": "Activity",
          "scale": {
            "domain": [
              "Development",
              "Publishing"
            ],
            "range": [
              "#0072B2",
              "#E69F00"
            ]
          },
          "legend": {
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "activity",
            "type": "nominal",
            "title": "Circle"
          },
          {
            "field": "game_count",
            "type": "quantitative",
            "title": "This circle's listings",
            "format": ",.0f"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "subtitleColor": "#526274"
    }
  }
}
