{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which Countries Lead Game Development and Publishing?"
  },
  "width": 942,
  "height": 462,
  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "center_to"
    },
    "scale": {
      "expr": "zoom_level"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white",
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray",
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.developed_games) && isValid(datum.published_games) && isValid(datum.latitude) && isValid(datum.longitude)"
        },
        {
          "calculate": "datum.developed_games + datum.published_games",
          "as": "Total_listings"
        },
        {
          "filter": "datum.Total_listings > 0"
        },
        {
          "calculate": "datum.country === 'USA' ? 'United States' : datum.country",
          "as": "country"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#C2410C",
        "fillOpacity": 0.9,
        "stroke": "#8A2E0A",
        "strokeWidth": 1,
        "strokeOpacity": 1,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "Total_listings",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "Total_listings",
          "type": "quantitative",
          "title": "Total listings",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              18137
            ],
            "range": [
              0,
              2200
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              100,
              1000,
              5000,
              15000
            ],
            "format": ",.0f",
            "symbolFillColor": "#C2410C",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "offset": 16,
            "encode": {
              "symbols": {
                "update": {
                  "stroke": {
                    "value": "#8A2E0A"
                  },
                  "strokeWidth": {
                    "value": 1
                  },
                  "fillOpacity": {
                    "value": 0.9
                  }
                }
              }
            }
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "Total_listings",
            "type": "quantitative",
            "title": "Total listings",
            "format": ",.0f"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "subtitleColor": "#526274"
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "text": {
      "fontSize": 11
    }
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 174,
      "bind": {
        "input": "range",
        "min": 174,
        "max": 1200,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            0
          ],
          [
            -98,
            40
          ],
          [
            10,
            50
          ],
          [
            125,
            33
          ],
          [
            110,
            5
          ]
        ],
        "labels": [
          "World",
          "North America",
          "Europe",
          "East Asia",
          "Southeast Asia"
        ],
        "name": "Map Centre: "
      }
    }
  ]
}
