{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which Countries Lead Game Development and Publishing?"
  },
  "width": 1020,
  "height": 500,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/TiffanyLauKhoJen/FIT3179-DV2-VideoGames/main/data/gamecompanies_development_publishing_by_country_with_coordinates.csv",
        "format": {
          "type": "csv",
          "parse": {
            "developed_games": "number",
            "published_games": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.developed_games) && isValid(datum.published_games) && isValid(datum.latitude) && isValid(datum.longitude)"
        },
        {
          "calculate": "datum.developed_games + datum.published_games",
          "as": "Total_listings"
        },
        {
          "filter": "datum.Total_listings > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#C2410C",
        "fillOpacity": 0.9,
        "stroke": "#8A2E0A",
        "strokeWidth": 1,
        "strokeOpacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "Total_listings",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "Total_listings",
          "type": "quantitative",
          "title": "Total listings",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              18137
            ],
            "range": [
              0,
              2200
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              100,
              1000,
              5000,
              15000
            ],
            "format": ",.0f",
            "symbolFillColor": "#C2410C",
            "labelFontSize": 12,
            "titleFontSize": 13,
            "offset": 16,
            "encode": {
              "symbols": {
                "update": {
                  "stroke": {
                    "value": "#8A2E0A"
                  },
                  "strokeWidth": {
                    "value": 1
                  },
                  "fillOpacity": {
                    "value": 0.9
                  }
                }
              }
            }
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Location"
          },
          {
            "field": "Total_listings",
            "type": "quantitative",
            "title": "Total listings",
            "format": ",.0f"
          },
          {
            "field": "developed_games",
            "type": "quantitative",
            "title": "Development listings",
            "format": ",.0f"
          },
          {
            "field": "published_games",
            "type": "quantitative",
            "title": "Publishing listings",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "title": {
      "anchor": "start",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "subtitleColor": "#526274"
    }
  }
}
